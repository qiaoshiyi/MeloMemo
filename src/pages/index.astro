---
// MeloMemo · 公共音乐社区首页（落地页）
// 文案与站长内容来自 src/data/content.js；社区数据在 Supabase，由页面底部脚本实时拉取
import Content from '../data/content.js';
import '../styles/global.css';

const songs = Content.songs ?? [];
const videos = Content.videos ?? [];
const projects = Content.projects ?? [];
const tags = Content.tags ?? [];
const features = Content.features ?? [];
const cm = Content.comments ?? {};
const c = Content.contact ?? {};
const discussionsUrl = cm.repo ? `https://github.com/${cm.repo}/discussions` : "";
const giscusOn = Boolean(cm.repoId && cm.categoryId);
const year = new Date().getFullYear();
const site = "https://melomemo.cn";
const desc = Content.tagline || Content.slogan;

const links = [
  { href: '#features', label: '怎么玩' },
  { href: '#latest', label: '最新作品' },
  { href: '#discover', label: '发现音乐人' },
  songs.length > 0 && { href: '#songs', label: `听 ${Content.name}` },
  projects.length > 0 && { href: '#projects', label: '作品' },
  { href: '#comments', label: '留言板' },
].filter(Boolean);
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MeloMemo · 公共音乐交友平台，唱给懂你的人听</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content="翻唱,原创音乐,音乐交友,上传歌曲,独立音乐人,MeloMemo" />
    <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f5fc" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="apple-touch-icon" href="favicon.svg" />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="dns-prefetch" href="https://mhfhbuivdwmdhqikjryu.supabase.co" />

    <meta property="og:site_name" content="MeloMemo" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:title" content="MeloMemo · 唱给懂你的人听" />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="MeloMemo · 唱给懂你的人听" />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "MeloMemo",
      alternateName: "MeloMemo 音乐社区",
      url: `${site}/`,
      description: desc,
      inLanguage: "zh-CN",
      potentialAction: {
        "@type": "SearchAction",
        target: `${site}/app/#/feed?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    })} />
    <script is:inline>
      // 进入页面前先应用保存的主题，避免闪色
      try {
        var saved = localStorage.getItem('mm-theme');
        if (saved) document.documentElement.dataset.theme = saved;
        else if (window.matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
  </head>
  <body data-slogan={Content.slogan}>
    <div id="progress"></div>

    <a class="skip" href="#features">跳到主要内容</a>

    <nav>
      <div class="wrap">
        <a class="logo" href="#top">🎶 MeloMemo</a>
        {links.map(l => <a class="item" href={l.href}>{l.label}</a>)}
        <a class="item join" href="app/#/feed">🎤 进入社区</a>
        <button id="themeBtn" type="button" title="切换明暗主题" aria-label="切换明暗主题">🌙</button>
      </div>
    </nav>

    <header class="hero" id="top">
      <span class="float-note" style="left:12%; top:22%;" aria-hidden="true">🎵</span>
      <span class="float-note" style="left:22%; top:58%; animation-delay:-2.2s;" aria-hidden="true">🎶</span>
      <span class="float-note" style="left:74%; top:26%; animation-delay:-4s;" aria-hidden="true">🎵</span>
      <span class="float-note" style="left:86%; top:60%; animation-delay:-5.5s;" aria-hidden="true">🎶</span>
      <div class="wrap">
        <p class="kicker">公共音乐交友平台 · {year}</p>
        <h1>MeloMemo</h1>
        <p class="slogan"><span id="typed"></span><span class="caret" aria-hidden="true"></span></p>
        <p class="tagline">{Content.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="app/#/feed">🎧 去听大家唱的歌</a>
          <a class="btn ghost" href="app/#/login">🚀 注册并发布你的作品</a>
        </div>
        <p class="hero-note">不用下载 App，一首歌的时间就能交到同好。</p>
        <div class="live-stats" id="liveStats" hidden aria-live="polite"></div>
      </div>
    </header>

    <main class="wrap">
      {features.length > 0 && (
        <section id="features" class="reveal">
          <h2>这个站点怎么玩</h2>
          <div class="grid">
            {features.map(f => (
              <div class="card feature">
                <span class="fico" aria-hidden="true">{f.icon}</span>
                <h3>{f.title}</h3>
                <p class="note">{f.desc}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <section id="latest" class="reveal" hidden aria-live="polite">
        <div class="sec-head">
          <h2>最新作品</h2>
          <a class="more" href="app/#/feed">查看全部 →</a>
        </div>
        <div class="grid" id="latestList" aria-live="polite"></div>
        <p class="note" id="latestEmpty" hidden>还没有人上传作品，等你来当第一个 🎤</p>
      </section>

      <section id="discover" class="reveal">
        <div class="sec-head">
          <h2>🧭 认识一下这里的人</h2>
          <a class="more" href="app/#/discover">发现音乐人 →</a>
        </div>
        <p class="lead">唱歌的人比歌单更值得翻。按作品数、被关注数排一排，点进去就能听。</p>
        <div class="grid" id="homePeople" aria-live="polite"></div>
      </section>

      {songs.length > 0 && (
        <section id="songs" class="reveal">
          <h2>听 {Content.name} 唱</h2>
          <div class="grid">
            {songs.map(s => (
              <div class="card">
                <div class="cover">
                  {s.cover ? <img src={s.cover} alt={s.title} /> : <span aria-hidden="true">🎤</span>}
                  <span class="hole"></span>
                </div>
                <div class="row">
                  <h3>{s.title}</h3>
                  <div class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                </div>
                {s.note && <span class="note">{s.note}</span>}
                <audio controls preload="none" src={s.file}></audio>
              </div>
            ))}
          </div>
        </section>
      )}

      {videos.length > 0 && (
        <section id="videos" class="reveal">
          <h2>视频</h2>
          <div class="grid">
            {videos.map(v => (
              <div class="card video-card">
                <iframe src={v.embed} title={v.title} allowfullscreen loading="lazy"></iframe>
                <h3>{v.title}</h3>
              </div>
            ))}
          </div>
        </section>
      )}

      {projects.length > 0 && (
        <section id="projects" class="reveal">
          <h2>作品集</h2>
          <div class="grid">
            {projects.map(p => (
              <div class="card">
                <h3>{p.title}</h3>
                <p class="note">{p.desc}</p>
                {p.link && <a class="btn ghost" style="padding:8px 18px;" href={p.link} target="_blank" rel="noopener">去看看 →</a>}
              </div>
            ))}
          </div>
        </section>
      )}

      <section id="about" class="reveal">
        <h2>关于 {Content.name}</h2>
        <p class="about-text">{Content.about}</p>
        {tags.length > 0 && (
          <div class="tagwall" aria-label="常听的风格">
            {tags.map(t => <span>{t}</span>)}
          </div>
        )}
      </section>

      <section id="comments" class="reveal">
        <h2>留言板</h2>
        <p class="lead">想认识谁、想说什么，都可以留在这里。</p>
        <div class="card comment-box">
          {giscusOn ? (
            <div>
              <p class="note giscus-hint">留言板由 GitHub Discussions 提供，需要用 GitHub 账号登录；没有账号也可以直接在 <a href="app/">社区</a> 里给作品留言。</p>
              <script is:inline src="https://giscus.app/client.js"
                data-repo={cm.repo} data-repo-id={cm.repoId}
                data-category={cm.category || "Announcements"} data-category-id={cm.categoryId}
                data-mapping="pathname" data-strict="0" data-reactions-enabled="1"
                data-theme="preferred_color_scheme" data-lang="zh-CN" data-loading="lazy"
                crossorigin="anonymous" async></script>
            </div>
          ) : (
            <div class="empty" style="border:none;">
              留言板正在装修中 🛠 —— 现阶段欢迎去 GitHub 上找我留言：<br />
              <a class="btn primary" style="margin-top:10px;" href={discussionsUrl} target="_blank" rel="noopener">去 GitHub Discussions 留言</a>
            </div>
          )}
        </div>
      </section>

      <section id="contact" class="reveal">
        <h2>联系与反馈</h2>
        <div class="contact-list">
          {c.github && <a href={c.github} target="_blank" rel="noopener">💻 GitHub</a>}
          {c.issues && <a href={c.issues} target="_blank" rel="noopener">🐞 问题反馈 / 侵权投诉</a>}
          {c.bilibili && <a href={c.bilibili} target="_blank" rel="noopener">📺 B站</a>}
          {c.email && <a href={c.email}>✉️ 邮箱</a>}
        </div>
        <p class="legal-links">
          <a href="legal/">用户协议</a> · <a href="legal/#privacy">隐私政策</a> · <a href="legal/#report">举报与版权投诉</a>
        </p>
      </section>
    </main>

    <footer class="site">
      <div class="wrap">© {year} {Content.footer}</div>
    </footer>

    <!-- 迷你播放条：点开作品后跟随在底部 -->
    <div id="mini" hidden role="region" aria-label="正在播放">
      <div class="mini-cover" id="miniCover"><i class="disc-label" id="miniCoverLabel">🎤</i></div>
      <div class="mini-info">
        <strong id="miniTitle"></strong>
        <span class="mini-author" id="miniAuthor"></span>
        <div class="mini-timerow">
          <div class="mini-bar"><i id="miniFill"></i></div>
          <span class="mini-time" id="miniTime">0:00 / 0:00</span>
        </div>
      </div>
      <button id="miniToggle" type="button" title="播放/暂停" aria-label="播放或暂停">⏸</button>
      <button id="miniClose" type="button" title="关闭" aria-label="关闭播放条">✕</button>
    </div>

    <button id="toTop" type="button" title="回到顶部" aria-label="回到顶部">↑</button>

    <style>
      .skip {
        position: absolute; left: -9999px; top: 0; z-index: 100;
        background: var(--accent); color: #fff; padding: 10px 16px; border-radius: 0 0 12px 0;
      }
      .skip:focus { left: 0; }
      .hero .kicker { color: var(--muted); font-size: 13.5px; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 10px; }
      .hero .tagline { color: var(--muted); max-width: 620px; margin: 0 auto 26px; font-size: 16.5px; }
      .hero-note { color: var(--muted); font-size: 13px; margin: 16px 0 0; }
      .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .more { color: var(--accent-2); text-decoration: none; font-size: 14.5px; font-weight: 600; }
      .more:hover { text-decoration: underline; }
      .feature { gap: 6px; }
      .fico { font-size: 26px; line-height: 1; }
      .lead { color: var(--muted); margin: -8px 0 16px; }
      .giscus-hint { margin: 0 0 12px; }
      .giscus-hint a { color: var(--accent-2); }
      .legal-links { color: var(--muted); font-size: 13.5px; margin: 14px 0 0; }
      .legal-links a { color: var(--muted); }
      .legal-links a:hover { color: var(--ink); }
      .work-cover {
        height: 120px; border-radius: 14px; position: relative; overflow: hidden;
        display: flex; align-items: center; justify-content: center; font-size: 40px; color: #fff;
        background: linear-gradient(135deg, #2b3a67, #6c8cff 55%, #ff5e7a);
      }
      .byline { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
      .byline a { color: var(--accent-2); text-decoration: none; font-weight: 700; }
      .work-meta { color: var(--muted); font-size: 12.5px; }
      /* 实时社区数据 */
      .live-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 26px 0 0; }
      .live-stats .st { min-width: 92px; padding: 9px 16px; border-radius: 14px; border: 1px solid var(--card-border); background: color-mix(in srgb, var(--card) 70%, transparent); backdrop-filter: blur(8px); }
      .live-stats .st b { display: block; font-size: 20px; line-height: 1.2; color: var(--ink); }
      .live-stats .st span { font-size: 12px; color: var(--muted); }
      .work-badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 6px; }
      .work-badges i { font-style: normal; font-size: 11.5px; color: var(--accent-2); background: color-mix(in srgb, var(--accent-2) 12%, transparent); border-radius: 999px; padding: 2px 9px; }
      .work-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 6px; font-size: 12.5px; color: var(--muted); }
      .work-foot a { color: var(--accent-2); text-decoration: none; font-weight: 600; }
      .work-cover { cursor: pointer; }
      .work-cover::after { content: '▶'; position: absolute; inset: 0; display: grid; place-items: center; font-size: 34px; color: #fff; background: rgba(11,16,32,.28); opacity: 0; transition: opacity .18s ease; }
      .card.playing .work-cover::after { content: '❚❚'; opacity: 1; }
      .work-cover:hover::after { opacity: .9; }
      .home-person { display: flex; gap: 12px; align-items: center; text-decoration: none; color: inherit; }
      .home-person .mini-avatar { flex: none; }
      .home-person .hp-info { min-width: 0; }
      .home-person .hp-name { display: block; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .home-person .hp-handle { display: block; font-size: 12.5px; color: var(--muted); }
      .home-person .hp-nums { display: block; font-size: 12px; color: var(--muted); margin-top: 6px; }
      .home-person .hp-nums b { color: var(--ink); }
      @media (max-width: 640px) { .live-stats .st { min-width: 76px; padding: 8px 12px; } .live-stats .st b { font-size: 17px; } }
    </style>

    <script is:inline src="config.js"></script>
    <script>
      // ===== 明暗主题切换（留言板 giscus 主题一起跟着换） =====
      const themeBtn = document.getElementById('themeBtn');
      const syncGiscus = (t) => {
        document.querySelectorAll('iframe.giscus-frame').forEach(f => {
          f.contentWindow.postMessage({ giscus: { setConfig: { theme: t === 'dark' ? 'dark' : 'light' } } }, 'https://giscus.app');
        });
      };
      const setTheme = (t) => {
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('mm-theme', t); } catch (e) {}
        themeBtn.textContent = t === 'dark' ? '🌙' : '☀️';
        themeBtn.setAttribute('aria-label', t === 'dark' ? '切换到浅色主题' : '切换到深色主题');
        syncGiscus(t);
      };
      setTheme(document.documentElement.dataset.theme || 'dark');
      themeBtn.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      // ===== 打字机欢迎语（口号放在 <body data-slogan> 里） =====
      const typedEl = document.getElementById('typed');
      const text = document.body.dataset.slogan || '';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) typedEl.textContent = text;
      else (function type(i) {
        if (i <= text.length) { typedEl.textContent = text.slice(0, i++); setTimeout(() => type(i), 95); }
      })(0);

      // ===== 顶部进度条 + 回到顶部按钮显隐 =====
      const bar = document.getElementById('progress');
      const toTop = document.getElementById('toTop');
      addEventListener('scroll', () => {
        const h = document.documentElement;
        const p = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight) * 100;
        bar.style.width = p + '%';
        toTop.classList.toggle('show', h.scrollTop > 500);
      }, { passive: true });
      toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));

      // ===== 滚动浮现 =====
      const io = new IntersectionObserver(es => {
        es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));

      // ===== 迷你播放条：同一时间只播一首 =====
      const mini = document.getElementById('mini');
      const miniTitle = document.getElementById('miniTitle');
      const miniAuthor = document.getElementById('miniAuthor');
      const miniFill = document.getElementById('miniFill');
      const miniTime = document.getElementById('miniTime');
      const miniToggle = document.getElementById('miniToggle');
      const miniClose = document.getElementById('miniClose');
      const miniCoverLabel = document.getElementById('miniCoverLabel');
      const miniCover = document.getElementById('miniCover');
      const fmtT = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
      let currentAudio = null;

      mini.addEventListener('click', e => e.stopPropagation());
      miniToggle.addEventListener('click', () => {
        if (!currentAudio) return;
        currentAudio.paused ? currentAudio.play() : currentAudio.pause();
      });
      miniClose.addEventListener('click', () => {
        if (currentAudio) currentAudio.pause();
        mini.hidden = true;
      });

      function wireCard(card) {
        const audio = card.querySelector('audio');
        if (!audio) return;
        const title = card.querySelector('h3')?.textContent || '正在播放';
        const author = card.dataset.author || '';
        const cover = card.querySelector('.work-cover');
        const coverUrl = card.dataset.cover || '';
        const coverBg = cover ? getComputedStyle(cover).backgroundImage : '';
        // 点封面即可播放 / 暂停（和社区页保持一致）
        if (cover) cover.addEventListener('click', () => { audio.paused ? audio.play() : audio.pause(); });
        audio.addEventListener('play', () => {
          document.querySelectorAll('audio').forEach(a => { if (a !== audio) a.pause(); });
          document.querySelectorAll('.playing').forEach(x => x.classList.remove('playing'));
          card.classList.add('playing');
          currentAudio = audio;
          miniTitle.textContent = title;
          miniAuthor.textContent = author ? '🎤 ' + author : '';
          miniTime.textContent = '0:00 / ' + fmtT(audio.duration);
          if (coverBg && coverBg !== 'none') { miniCoverLabel.style.backgroundImage = coverBg; miniCoverLabel.textContent = ''; }
          else if (coverUrl) { miniCoverLabel.style.backgroundImage = `url("${coverUrl}")`; miniCoverLabel.textContent = ''; }
          else { miniCoverLabel.style.backgroundImage = ''; miniCoverLabel.textContent = '🎤'; }
          mini.hidden = false;
          miniToggle.textContent = '⏸';
          miniCover.classList.add('spin');
        });
        audio.addEventListener('playing', () => { miniToggle.textContent = '⏸'; });
        ['pause', 'ended'].forEach(ev => audio.addEventListener(ev, () => {
          card.classList.remove('playing');
          miniToggle.textContent = '▶';
          miniCover.classList.remove('spin');
        }));
        audio.addEventListener('timeupdate', () => {
          if (currentAudio !== audio) return;
          miniFill.style.width = (audio.currentTime / (audio.duration || 1) * 100) + '%';
          miniTime.textContent = fmtT(audio.currentTime) + ' / ' + fmtT(audio.duration);
        });
      }
      document.querySelectorAll('.card').forEach(wireCard);

      // ===== 首页实时作品流：直连 Supabase 公开只读接口 =====
      (async function latest() {
        const cfg = window.MELO_CONFIG || {};
        const sec = document.getElementById('latest');
        const list = document.getElementById('latestList');
        const empty = document.getElementById('latestEmpty');
        const stats = document.getElementById('liveStats');
        const peopleBox = document.getElementById('homePeople');
        if (!cfg.url || !cfg.anonKey) return;
        const esc = s => String(s ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
        const H = { apikey: cfg.anonKey, Accept: 'application/json' };
        const jget = async u => { const r = await fetch(u, { headers: H }); if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); };
        const mmss = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
        const hueOf = id => { let h = 0; for (const ch of String(id || '')) h = (h * 31 + ch.charCodeAt(0)) % 360; return h; };
        const grad = h => `linear-gradient(135deg,hsl(${h} 62% 32%),hsl(${(h + 48) % 360} 74% 52%),hsl(${(h + 110) % 360} 78% 62%))`;

        // 全站实时统计（一次 RPC 拿全，失败就安静不显示）
        if (stats) {
          jget(`${cfg.url}/rest/v1/rpc/site_stats`).then(rows => {
            const s = rows?.[0]; if (!s) return;
            stats.innerHTML = [
              [s.works_count, '首作品'], [s.people_count, '位音乐人'],
              [s.loves_count, '次喜欢'], [s.comments_count, '条留言'],
            ].map(([n, label]) => `<div class="st"><b>${Number(n || 0)}</b><span>${label}</span></div>`).join('');
            stats.hidden = false;
          }).catch(() => {});
        }

        // 最新作品：带上流派 / 时长 / 喜欢数 / 评论数
        try {
          const works = await jget(
            `${cfg.url}/rest/v1/works?select=id,title,note,genre,duration,plays,created_at,storage_path,profiles!works_user_id_fkey(username,display_name),loves(count),comments(count)&order=created_at.desc&limit=6`
          );
          if (sec) sec.hidden = false;
          if (!works.length) { if (empty) empty.hidden = false; }
          else if (list) {
            list.innerHTML = works.map(w => {
              const who = w.profiles || {};
              const url = `${cfg.url}/storage/v1/object/public/songs/${String(w.storage_path).split('/').map(encodeURIComponent).join('/')}`;
              const uname = who.username || '';
              const loves = Number(w.loves?.[0]?.count || 0), cmts = Number(w.comments?.[0]?.count || 0);
              const badges = [
                w.genre ? `<i>${esc(w.genre)}</i>` : '',
                Number(w.duration) > 0 ? `<i>${mmss(w.duration)}</i>` : '',
              ].filter(Boolean).join('');
              return `
              <div class="card" data-author="${esc(who.display_name || uname || '')}">
                <div class="work-cover" style="background:${grad(hueOf(w.id))}" title="点击播放 / 暂停">🎤</div>
                <div class="row"><h3>${esc(w.title)}</h3></div>
                ${w.note ? `<span class="note">${esc(w.note)}</span>` : ''}
                ${badges ? `<div class="work-badges">${badges}</div>` : ''}
                <div class="work-foot">
                  <span>by <a href="app/#/u/${esc(uname)}">${esc(who.display_name || uname || '神秘音乐人')}</a></span>
                  <span>▶ ${w.plays || 0} · ♥ ${loves} · 💬 ${cmts}</span>
                </div>
                <audio controls preload="none" src="${esc(url)}" data-work-id="${esc(w.id)}"></audio>
              </div>`;
            }).join('');
            list.querySelectorAll('.card').forEach(wireCard);
          }
        } catch (e) {
          if (sec) sec.hidden = true; // 拉不到就安静隐藏，不影响落地页
        }

        // 首页推荐几位音乐人（游客可见，走公开 RPC）
        if (peopleBox) {
          try {
            const rows = await jget(`${cfg.url}/rest/v1/rpc/discover_people?p_q=&p_limit=6&p_offset=0`);
            const shown = (rows || []).filter(p => Number(p.works_count) > 0).slice(0, 3);
            if (shown.length) {
              peopleBox.innerHTML = shown.map(p => {
                const name = p.display_name || p.username || '神秘音乐人';
                const h = hueOf(p.username);
                return `<a class="card home-person" href="app/#/u/${esc(p.username)}">
                  <span class="mini-avatar" style="width:48px;height:48px;font-size:20px;background:${grad(h)};color:#fff">${esc(name.slice(0, 1))}</span>
                  <span class="hp-info"><span class="hp-name">${esc(name)}</span><span class="hp-handle">@${esc(p.username)}</span>
                  <span class="hp-nums"><b>${p.works_count ?? 0}</b> 首作品 · <b>${p.followers_count ?? 0}</b> 位粉丝</span></span>
                </a>`;
              }).join('');
            }
          } catch (e) { /* 安静降级 */ }
        }
      })();
    </script>
  </body>
</html>
