---
// 页面主文件：结构和排版在这里，内容全部来自 src/data/content.js
import Content from '../data/content.js';
import '../styles/global.css';

const songs = Content.songs ?? [];
const videos = Content.videos ?? [];
const projects = Content.projects ?? [];
const c = Content.contact ?? {};

// 导航只显示非空区块
const links = [
  { href: '#about', label: '关于我' },
  songs.length > 0 && { href: '#songs', label: '歌曲' },
  videos.length > 0 && { href: '#videos', label: '视频' },
  projects.length > 0 && { href: '#projects', label: '作品' },
  Object.values(c).some(v => v) && { href: '#contact', label: '联系我' },
].filter(Boolean);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{Content.name} · 个人主页</title>
    <meta name="description" content={Content.slogan} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${Content.name} · 个人主页`} />
    <meta property="og:description" content={Content.slogan} />
    <meta property="og:type" content="website" />
    {Content.avatar && <meta property="og:image" content={Content.avatar} />}
  </head>
  <body>
    <nav>
      <div class="wrap">
        <a class="logo" href="#top">🏡 {Content.name}</a>
        {links.map(l => <a class="item" href={l.href}>{l.label}</a>)}
      </div>
    </nav>

    <header class="hero" id="top">
      <div class="wrap">
        {Content.avatar && <img class="avatar" src={Content.avatar} alt="头像" />}
        <h1>{Content.name}</h1>
        <p>{Content.slogan}</p>
      </div>
    </header>

    <main class="wrap">
      <section id="about">
        <h2>👋 关于我</h2>
        <p class="about-text">{Content.about}</p>
      </section>

      <section id="songs">
        <h2>🎵 我的歌声</h2>
        {songs.length === 0
          ? <div class="empty">还没有歌曲。把 MP3 放进 public/media/ 文件夹，再到 src/data/content.js 里加一行就能显示在这里。</div>
          : (
            <div class="grid">
              {songs.map(s => (
                <div class="card">
                  <div class="cover">
                    {s.cover ? <img src={s.cover} alt={s.title} /> : <span>🎧</span>}
                  </div>
                  <h3>{s.title}</h3>
                  {s.note && <span class="note">{s.note}</span>}
                  <audio controls preload="none" src={s.file}></audio>
                </div>
              ))}
            </div>
          )}
      </section>

      <section id="videos">
        <h2>🎬 我的视频</h2>
        {videos.length === 0
          ? <div class="empty">还没有视频。传到 B 站或 YouTube 后，把嵌入链接贴到 src/data/content.js 即可。</div>
          : (
            <div class="grid">
              {videos.map(v => (
                <div class="card video-card">
                  <iframe src={v.embed} title={v.title}
                    allowfullscreen loading="lazy"></iframe>
                  <h3>{v.title}</h3>
                </div>
              ))}
            </div>
          )}
      </section>

      {projects.length > 0 && (
        <section id="projects">
          <h2>🛠 作品集</h2>
          <div class="grid">
            {projects.map(p => (
              <div class="card">
                <h3>{p.title}</h3>
                <p class="note">{p.desc}</p>
                {p.link && <a class="proj" href={p.link} target="_blank" rel="noopener">去看看 →</a>}
              </div>
            ))}
          </div>
        </section>
      )}

      {Object.values(c).some(v => v) && (
        <section id="contact">
          <h2>📮 联系我</h2>
          <div class="contact-list">
            {c.github && <a href={c.github} target="_blank" rel="noopener">💻 GitHub</a>}
            {c.bilibili && <a href={c.bilibili} target="_blank" rel="noopener">📺 B站</a>}
            {c.email && <a href={c.email}>✉️ 邮箱</a>}
          </div>
        </section>
      )}
    </main>

    <footer class="site">
      <div class="wrap">{Content.footer}</div>
    </footer>
  </body>
</html>
