---
// MeloMemo · 社区应用页（游客可浏览 / 注册登录 / 发布作品 / 社区动态 / 个人主页）
// 全部交互在浏览器端完成，后端是 Supabase（见 supabase/schema.sql 与 public/config.js）
import Content from '../data/content.js';
import '../styles/global.css';

const year = new Date().getFullYear();
const site = 'https://melomemo.cn';
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>社区动态 · MeloMemo 唱给懂你的人听</title>
    <meta name="description" content="MeloMemo 音乐社区：听大家的翻唱与原创，关注喜欢的声音，上传你自己的作品，交到同好朋友。" />
    <link rel="canonical" href={`${site}/app/`} />
    <link rel="icon" type="image/svg+xml" href="../favicon.svg" />
    <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="MeloMemo" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${site}/app/`} />
    <meta property="og:title" content="MeloMemo 社区 · 唱给懂你的人听" />
    <meta property="og:description" content="听大家的翻唱与原创，关注喜欢的声音，上传你自己的作品。" />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://mhfhbuivdwmdhqikjryu.supabase.co" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js" defer></script>
    <script is:inline src="../config.js"></script>
    <script is:inline>
      try {
        var __t = localStorage.getItem('mm-theme');
        if (__t) document.documentElement.dataset.theme = __t;
        else if (window.matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <nav>
      <div class="wrap">
        <a class="logo" href="../">🎶 MeloMemo</a>
        <a class="item" href="#/feed">社区动态</a>
        <a class="item" href="#/discover">发现音乐人</a>
        <a class="item" href="#/publish">发布作品</a>
        <a class="item" href="#/me">我的主页</a>
        <a class="item notify" id="noticesNavBtn" href="#/notices" hidden>🔔 通知<i class="dot" id="noticeDot" hidden></i></a>
        <a class="item join" id="authNavBtn" href="#/login">登录 / 注册</a>
        <button id="themeBtn" type="button" title="切换明暗主题" aria-label="切换明暗主题">🌙</button>
      </div>
    </nav>

    <main class="wrap app" id="main">
      <!-- 未接入 Supabase 时的提示 -->
      <div id="setupBanner" class="setup" hidden>
        🛠 社区服务正在初始化——数据库接上后这里就是注册入口。
      </div>

      <!-- 登录 / 注册 -->
      <section id="authView" hidden>
        <h2>🎤 加入 <span class="hl">MeloMemo 社区</span></h2>
        <p class="lead">注册一个账号，上传你的翻唱和原创，去别人的主页听歌、点关注，陪着音乐交朋友。</p>
        <div class="card auth-card">
          <div class="tabs2" role="tablist">
            <button class="seg on" data-mode="login" role="tab" aria-selected="true">登录</button>
            <button class="seg" data-mode="signup" role="tab" aria-selected="false">注册</button>
          </div>
          <label>邮箱 <input id="email" type="email" placeholder="you@example.com" autocomplete="email" /></label>
          <label>密码 <input id="password" type="password" placeholder="至少 8 位" autocomplete="current-password" /></label>
          <div id="captchaBox" class="captcha-box" hidden></div>
          <button id="authBtn" class="btn primary">登录</button>
          <div class="auth-links">
            <button id="forgotBtn" class="linkbtn" type="button">忘记密码？</button>
            <a class="linkbtn" href="#/feed">先随便听听 →</a>
          </div>
          <p id="authMsg" class="msg" role="status"></p>
        </div>
      </section>

      <!-- 重设密码（邮件里的找回链接会回到这里） -->
      <section id="resetView" hidden>
        <h2>🔑 设置新密码</h2>
        <div class="card auth-card">
          <label>新密码 <input id="newPassword" type="password" placeholder="至少 8 位" autocomplete="new-password" /></label>
          <button id="resetBtn" class="btn primary">保存新密码</button>
          <p id="resetMsg" class="msg" role="status"></p>
        </div>
      </section>

      <!-- 登录后的社区 -->
      <section id="shell" hidden>
        <div class="whoami card">
          <div class="mini-avatar" id="mineAvatar">🎵</div>
          <div class="who">
            <strong id="mineName"></strong>
            <span id="mineHandle" class="muted"></span>
          </div>
          <button id="logoutBtn" class="btn ghost tiny" type="button">退出登录</button>
        </div>

        <div class="tabs3" role="tablist">
          <button data-view="feed" class="on" role="tab">🔥 社区动态</button>
          <button data-view="publish" role="tab">⬆️ 发布作品</button>
          <button data-view="me" role="tab">🏠 我的主页</button>
        </div>

        <!-- 社区动态 -->
        <div id="feedView">
          <div class="feed-tools">
            <input id="feedSearch" type="search" placeholder="🔍 搜索歌名或说明…" aria-label="搜索作品" />
            <div class="sortseg">
              <button class="smini on" data-sort="new" type="button">最新</button>
              <button class="smini" data-sort="hot" type="button">最热</button>
            </div>
          </div>
          <div class="chipsrow" id="genreRow" role="group" aria-label="按流派筛选">
            <button class="gchip on" data-genre="" type="button">全部</button>
            <button class="gchip" data-genre="翻唱" type="button">翻唱</button>
            <button class="gchip" data-genre="原创" type="button">原创</button>
            <button class="gchip" data-genre="民谣" type="button">民谣</button>
            <button class="gchip" data-genre="流行" type="button">流行</button>
            <button class="gchip" data-genre="摇滚" type="button">摇滚</button>
            <button class="gchip" data-genre="说唱" type="button">说唱</button>
            <button class="gchip" data-genre="电子" type="button">电子</button>
            <button class="gchip" data-genre="古风" type="button">古风</button>
            <button class="gchip" data-genre="纯音乐" type="button">纯音乐</button>
            <button class="gchip" data-genre="其他" type="button">其他</button>
          </div>
          <div class="guestbar card" id="guestBar" hidden>
            <span>你现在是游客，可以随便听。想发布作品或关注作者，<a href="#/login">登录 / 注册</a> 后即可。</span>
          </div>
          <p class="feedstats" id="feedStats"></p>
          <div class="grid" id="feedList" aria-live="polite"></div>
          <div class="pager" id="feedMoreWrap" hidden>
            <button id="feedMore" class="btn ghost" type="button">加载更多</button>
          </div>
        </div>

        <!-- 发布作品 -->
        <div id="publishView" hidden>
          <div class="card form-card">
            <label>歌曲标题 <input id="songTitle" maxlength="100" placeholder="例如：《南山南》翻唱" /></label>
            <label>一句话说明（可选）<input id="songNote" maxlength="200" placeholder="翻唱 · 吉他自弹 · 2026" /></label>
            <label>流派
              <select id="songGenre">
                <option value="翻唱">翻唱</option>
                <option value="原创">原创</option>
                <option value="民谣">民谣</option>
                <option value="流行">流行</option>
                <option value="摇滚">摇滚</option>
                <option value="说唱">说唱</option>
                <option value="电子">电子</option>
                <option value="古风">古风</option>
                <option value="纯音乐">纯音乐</option>
                <option value="其他">其他</option>
              </select>
            </label>
            <label>音频文件 <input id="songFile" type="file" accept="audio/*" /></label>
            <p class="note">支持 MP3 / M4A / WAV / OGG，单个文件不超过 50MB。请只上传自己演唱或已获授权的作品。</p>
            <button id="publishBtn" class="btn primary" type="button">🚀 发布</button>
            <div id="upWrap" class="upwrap">
              <div class="upbar"><i id="upFill"></i></div>
              <div id="upText" class="uptext"></div>
            </div>
            <p id="publishMsg" class="msg" role="status"></p>
          </div>
          <h3 class="sub">我发布过的 <span id="myCount" class="muted"></span></h3>
          <div class="grid" id="mineList"></div>
        </div>

        <!-- 我的主页（编辑资料） -->
        <div id="meView" hidden>
          <div class="card form-card">
            <div class="av-edit">
              <button id="avatarBtn" class="mini-avatar big" type="button" title="点击更换头像" aria-label="更换头像">🎵</button>
              <span class="muted">点头像换新图<br />PNG/JPG · ≤3MB · 方形最佳</span>
              <input id="avatarFile" type="file" accept="image/png,image/jpeg,image/webp" hidden />
            </div>
            <label>昵称 <input id="pfName" maxlength="24" /></label>
            <label>个人简介 <input id="pfBio" maxlength="80" placeholder="一句话介绍你的音乐" /></label>
            <label>主页地址（字母/数字/下划线）<input id="pfUsername" maxlength="24" /></label>
            <button id="saveProfileBtn" class="btn primary" type="button">保存</button>
            <p id="profileMsg" class="msg" role="status"></p>
          </div>
          <p class="muted center">你的公开主页是：<span id="myUrl" class="mono"></span></p>
          <p class="muted center">
            想删除账号与全部数据？请到 <a href="../legal/#report">举报与投诉页</a> 提交，我们会核实后处理。
          </p>
          <h3 class="sub">我喜欢的 <span id="loveCount" class="muted"></span></h3>
          <div class="grid" id="loveList"></div>
          <p class="muted center" id="loveEmpty" hidden>还没有喜欢过别人的作品，去社区听听看 🎧</p>
        </div>
      </section>

      <!-- 他人主页（游客也能看） -->
      <section id="profileView" hidden>
        <div class="empty" id="pfNotFound" hidden>
          没有找到这个主页，检查一下地址是否正确 🎐<br />
          <a href="#/feed">去社区看看</a>
        </div>
        <div class="card profile-card" id="pfCard">
          <div class="pf-banner" id="pfBanner" aria-hidden="true"></div>
          <div class="mini-avatar big" id="pfAvatar">🎵</div>
          <div class="pf-head">
            <h2 id="pfDisplay"></h2>
            <span class="muted" id="pfHandle"></span>
            <p class="muted" id="pfBio"></p>
            <div class="stats">
              <span><b id="pfWorks">0</b> 作品</span>
              <span><b id="pfFollowers">0</b> 粉丝</span>
              <span><b id="pfFollowing">0</b> 关注中</span>
            </div>
            <div class="frows" id="pfFollowRows"></div>
          </div>
          <div class="pf-actions">
            <button id="followBtn" class="btn primary" type="button">关注</button>
            <button id="shareBtn" class="btn ghost tiny" type="button">🔗 分享主页</button>
          </div>
        </div>
        <div class="grid" id="pfWorksList"></div>
        <p class="muted center" id="pfEmpty" hidden>这位音乐人还没发布作品。</p>
      </section>

      <!-- 发现音乐人（游客也能看） -->
      <section id="discoverView" hidden>
        <div class="sec-head">
          <h2>🧭 发现音乐人</h2>
          <p class="muted">按作品数和被关注数排的，点进去就能听。</p>
        </div>
        <div class="feed-tools">
          <input id="peopleSearch" type="search" placeholder="🔍 搜索昵称或主页地址…" aria-label="搜索音乐人" />
        </div>
        <p class="feedstats" id="peopleStats"></p>
        <div class="people" id="peopleList" aria-live="polite"></div>
        <div class="pager" id="peopleMoreWrap" hidden>
          <button id="peopleMore" class="btn ghost" type="button">加载更多</button>
        </div>
      </section>

      <!-- 通知 -->
      <section id="noticesView" hidden>
        <div class="sec-head">
          <h2>🔔 通知</h2>
          <p class="muted">谁关注了你、喜欢了你的歌、在你的作品下留了言。</p>
        </div>
        <div class="notices" id="noticeList" aria-live="polite"></div>
        <p class="muted center" id="noticeEmpty" hidden>还没有新动静，先去给别人点个赞吧 🎧</p>
      </section>
    </main>

    <footer class="site">
      <div class="wrap">
        © {year} MeloMemo · 音乐是交朋友最快的路 ·
        <a href="../legal/">用户协议 / 隐私政策</a> ·
        <a href="../legal/#report">举报投诉</a>
      </div>
    </footer>

    <div id="mini" hidden role="region" aria-label="正在播放">
      <div class="mini-cover" id="miniCover"><i class="disc-label" id="miniCoverLabel">🎤</i></div>
      <div class="mini-info"><strong id="miniTitle"></strong><span id="miniAuthor" class="mini-author"></span><div class="mini-timerow"><div class="mini-bar"><i id="miniFill"></i></div><span id="miniTime" class="mini-time">0:00 / 0:00</span></div></div>
      <button id="miniToggle" type="button" title="播放/暂停" aria-label="播放或暂停">⏸</button>
      <button id="miniClose" type="button" title="关闭" aria-label="关闭播放条">✕</button>
    </div>

    <style>
      .app { padding: 34px 22px 80px; min-height: 70vh; }
      .lead { color: var(--muted); margin: -6px 0 18px; }
      .muted { color: var(--muted); }
      .center { text-align: center; }
      .mono { font-family: Consolas, monospace; font-size: 14px; }
      .sub { margin: 26px 0 14px; font-size: 18px; }
      .setup { background: var(--card); border: 1.5px dashed var(--card-border); padding: 22px; border-radius: 18px; margin: 18px 0 26px; text-align: center; color: var(--muted); }
      .msg { min-height: 1.4em; color: var(--muted); font-size: 14px; margin: 8px 0 0; }
      .msg.err { color: var(--accent); }
      .msg.ok { color: var(--accent-2); }
      .auth-card, .form-card { max-width: 460px; display: flex; flex-direction: column; gap: 14px; padding: 24px; margin: 0 auto; }
      .auth-card label, .form-card label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: var(--muted); }
      input[type=email], input[type=password], input[type=text], input[type=search], .form-card input:not([type=file]) {
        background: color-mix(in srgb, var(--bg) 55%, transparent);
        border: 1px solid var(--card-border); border-radius: 12px;
        color: var(--ink); padding: 11px 14px; font-size: 15px; outline: none;
      }
      input:focus { border-color: var(--accent-2); }
      .form-card input[type=file] { color: var(--muted); font-size: 13px; }
      .auth-links { display: flex; justify-content: space-between; gap: 10px; font-size: 13.5px; }
      .captcha-box { display: flex; justify-content: center; }
      .captcha-box:empty { display: none; }
      .linkbtn { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 13.5px; padding: 0; text-decoration: none; }
      .linkbtn:hover { color: var(--ink); text-decoration: underline; }
      .tabs2 { display: flex; gap: 6px; }
      .seg { flex: 1; padding: 10px; border-radius: 12px; border: 1px solid var(--card-border); background: none; color: var(--muted); cursor: pointer; font-size: 15px; }
      .seg.on { background: var(--gradient); color: #fff; border-color: transparent; font-weight: 700; }
      .whoami { flex-direction: row; align-items: center; gap: 12px; padding: 14px 18px; margin-bottom: 18px; }
      .who { display: flex; flex-direction: column; flex: 1; min-width: 0; }
      .who strong { font-size: 16px; }
      .btn.tiny { padding: 7px 14px; font-size: 13px; }
      nav a.item.join { color: #fff; background: var(--gradient); font-weight: 700; }
      .tabs3 { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
      .tabs3 button {
        padding: 10px 20px; border-radius: 999px; cursor: pointer; font-size: 14.5px;
        border: 1px solid var(--card-border); background: var(--card); color: var(--muted);
      }
      .tabs3 button.on { background: var(--gradient); color: #fff; border-color: transparent; font-weight: 700; }
      .mini-avatar {
        width: 46px; height: 46px; border-radius: 50%; flex: none;
        display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fff;
        background: var(--gradient);
      }
      .mini-avatar.big { width: 74px; height: 74px; font-size: 34px; }
      .av-edit { display: flex; align-items: center; gap: 14px; }
      #avatarBtn { cursor: pointer; border: none; padding: 0; background-size: cover; background-position: center; }
      #avatarBtn:hover { filter: brightness(1.12); }
      .mini-author { font-size: 12.5px; color: var(--muted); }
      .mini-timerow { display: flex; align-items: center; gap: 8px; }
      .mini-timerow .mini-bar { flex: 1; }
      .mini-time { font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; flex-shrink: 0; }
      .profile-card { flex-direction: row; align-items: center; gap: 16px; max-width: 640px; margin: 0 auto 22px; flex-wrap: wrap; position: relative; overflow: hidden; padding-top: 22px; }
      .pf-banner {
        position: absolute; left: 0; right: 0; top: 0; height: 78px;
        background: var(--gradient); opacity: .9;
        -webkit-mask-image: linear-gradient(#000, transparent); mask-image: linear-gradient(#000, transparent);
      }
      .profile-card > *:not(.pf-banner) { position: relative; z-index: 1; }
      .pf-stats { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
      .pf-stats span { padding: 3px 11px; border-radius: 999px; border: 1px solid var(--card-border); font-size: 12.5px; color: var(--muted); }
      .pf-stats b { color: var(--ink); font-size: 14px; margin-right: 2px; }
      .pf-head { flex: 1; min-width: 200px; }
      .pf-head h2 { margin: 0 0 2px; font-size: 22px; }
      .pf-head p { margin: 4px 0; font-size: 14px; }
      .stats { display: flex; gap: 16px; font-size: 13.5px; color: var(--muted); margin-top: 8px; }
      .stats b { color: var(--ink); font-size: 15px; }
      .work-cover { height: 120px; border-radius: 14px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 40px; color: #fff; background: linear-gradient(135deg, #2b3a67, #6c8cff 55%, #ff5e7a); }
      .playing .work-cover { animation: spin 3.2s linear infinite; }
      .work-cover { cursor: pointer; }
      .work-cover::after {
        content: '▶'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
        background: rgba(6, 10, 22, .34); font-size: 26px; opacity: 0; transition: opacity .2s ease;
      }
      .card:hover .work-cover::after { opacity: 1; }
      .card.playing .work-cover::after { content: '❚❚'; opacity: 0; }
      .card.playing:hover .work-cover::after { opacity: 1; }
      .mini-bar { cursor: pointer; }
      .byline { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
      .byline a { color: var(--accent-2); text-decoration: none; font-weight: 700; }
      .del { border: none; background: none; color: var(--muted); cursor: pointer; font-size: 14px; padding: 4px 8px; border-radius: 8px; }
      .del:hover { color: var(--accent); background: var(--card); }
      .mutual { font-size: 12px; background: var(--gradient); color: #fff; padding: 3px 10px; border-radius: 999px; }
      .pf-actions { display: flex; flex-direction: column; gap: 8px; align-items: stretch; }
      .guestbar { padding: 12px 18px; margin-bottom: 16px; font-size: 14px; color: var(--muted); }
      .guestbar a { color: var(--accent-2); font-weight: 600; }
      .feed-tools { display: flex; gap: 10px; margin-bottom: 18px; align-items: center; flex-wrap: wrap; }
      .feed-tools input {
        flex: 1; min-width: 200px;
        background: var(--card); border: 1px solid var(--card-border); border-radius: 999px;
        color: var(--ink); padding: 10px 16px; font-size: 14.5px; outline: none;
      }
      .feed-tools input:focus { border-color: var(--accent-2); }
      .sortseg { display: flex; gap: 4px; }
      .smini { padding: 9px 16px; border-radius: 999px; border: 1px solid var(--card-border); background: var(--card); color: var(--muted); cursor: pointer; font-size: 14px; }
      .smini.on { background: var(--gradient); color: #fff; border-color: transparent; font-weight: 700; }
      .pager { text-align: center; margin-top: 24px; }
      .chipsrow { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 18px; }
      .gchip {
        padding: 7px 15px; border-radius: 999px; cursor: pointer; font-size: 13.5px;
        border: 1px solid var(--card-border); background: var(--card); color: var(--muted);
        transition: transform .15s ease, background .2s ease;
      }
      .gchip:hover { transform: translateY(-1px); color: var(--ink); }
      .gchip.on { background: var(--gradient); color: #fff; border-color: transparent; font-weight: 700; }
      select {
        background: color-mix(in srgb, var(--bg) 55%, transparent);
        border: 1px solid var(--card-border); border-radius: 12px;
        color: var(--ink); padding: 11px 14px; font-size: 15px; outline: none;
      }
      .work-genre {
        font-size: 12px; padding: 2px 10px; border-radius: 999px; font-weight: 700;
        background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent);
      }
      .card-foot { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .feedstats { color: var(--muted); font-size: 13px; margin: -6px 0 14px; }
      .cmt-btn { border: 1px solid var(--card-border); background: transparent; color: var(--muted); border-radius: 999px; padding: 3px 10px; font-size: 12.5px; cursor: pointer; }
      .cmt-btn:hover { color: var(--ink); border-color: color-mix(in srgb, var(--accent-2) 60%, var(--card-border)); }
      .cmt-btn b { font-weight: 600; }
      .cmt-btn.share { padding: 3px 9px; }
      .cmt-btn.share:hover { color: var(--accent-2); }
      .cmt { border-top: 1px dashed var(--card-border); margin-top: 10px; padding-top: 10px; }
      .cmt-list { list-style: none; padding: 0; margin: 0 0 10px; display: flex; flex-direction: column; gap: 10px; max-height: 280px; overflow-y: auto; }
      .cmt-item { position: relative; font-size: 14px; line-height: 1.6; }
      .cmt-who { font-weight: 600; color: var(--ink); text-decoration: none; }
      .cmt-who:hover { color: var(--accent); }
      .cmt-time { color: var(--muted); font-size: 11.5px; margin-left: 6px; }
      .cmt-del { position: absolute; top: 0; right: 0; border: 0; background: transparent; color: var(--muted); cursor: pointer; font-size: 15px; line-height: 1; }
      .cmt-del:hover { color: var(--accent); }
      .cmt-body { margin: 2px 0 0; white-space: pre-wrap; word-break: break-word; }
      .cmt-form { display: flex; gap: 8px; }
      .cmt-input { flex: 1; padding: 8px 12px; border-radius: 12px; border: 1px solid var(--card-border); background: var(--card); color: var(--ink); font-size: 14px; }
      .cmt-form .btn { padding: 8px 16px; flex: none; }
      .dur { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; padding: 1px 7px; border-radius: 999px; border: 1px solid var(--card-border); }
      .skel { pointer-events: none; }
      .sk-cover { height: 120px; border-radius: 14px; background: color-mix(in srgb, var(--card-border) 55%, transparent); }
      .sk-line { height: 12px; border-radius: 8px; background: color-mix(in srgb, var(--card-border) 55%, transparent); }
      .sk-line.w60 { width: 60%; } .sk-line.w40 { width: 40%; } .sk-line.w80 { width: 80%; }
      .sk-cover, .sk-line { position: relative; overflow: hidden; }
      .sk-cover::after, .sk-line::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink) 10%, transparent), transparent);
        transform: translateX(-100%); animation: shimmer 1.35s infinite;
      }
      @keyframes shimmer { to { transform: translateX(100%); } }
      .love {
        border: 1px solid var(--card-border); background: none; color: var(--muted);
        border-radius: 999px; padding: 5px 13px; font-size: 13px; cursor: pointer;
        transition: transform .15s ease, color .2s ease, border-color .2s ease;
      }
      .love:hover { transform: translateY(-1px); color: var(--accent); border-color: var(--accent); }
      .love.on { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); font-weight: 700; }
      .toast-box {
        position: fixed; left: 50%; top: 18px; transform: translateX(-50%);
        display: flex; flex-direction: column; gap: 8px; z-index: 90; pointer-events: none;
        width: min(92vw, 460px);
      }
      .toast {
        background: var(--card); border: 1px solid var(--card-border); border-radius: 14px;
        padding: 11px 16px; font-size: 14px; box-shadow: var(--shadow); text-align: center;
        opacity: 0; transform: translateY(-10px); transition: opacity .28s ease, transform .28s ease;
      }
      .toast.in { opacity: 1; transform: translateY(0); }
      .toast.err { border-color: var(--accent); color: var(--accent); }
      .upwrap { display: none; flex-direction: column; gap: 6px; }
      .upwrap.show { display: flex; }
      .upbar { height: 8px; border-radius: 999px; background: color-mix(in srgb, var(--card-border) 60%, transparent); overflow: hidden; }
      .upbar i { display: block; height: 100%; width: 0%; border-radius: inherit; background: var(--gradient); transition: width .25s ease; }
      .uptext { font-size: 13px; color: var(--muted); text-align: center; }
      .frows { width: 100%; font-size: 13.5px; }
      .frow { display: flex; gap: 8px; align-items: flex-start; margin-top: 6px; flex-wrap: wrap; }
      .frow .lab { color: var(--muted); flex: none; padding-top: 4px; }
      .chip { display: inline-block; padding: 3px 12px; border-radius: 999px; background: color-mix(in srgb, var(--accent-2) 14%, transparent); color: var(--accent-2); text-decoration: none; font-weight: 600; }
      footer.site a { color: var(--muted); }
      /* 发现音乐人 */
      .people { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin-top: 14px; }
      .person { display: flex; gap: 12px; align-items: center; text-decoration: none; color: inherit; padding: 14px; border-radius: 16px; border: 1px solid var(--card-border); background: var(--card); transition: border-color .18s ease, transform .18s ease; }
      .person:hover { border-color: color-mix(in srgb, var(--accent-2) 55%, var(--card-border)); transform: translateY(-2px); }
      .person .mini-avatar { flex: none; }
      .person .p-info { min-width: 0; flex: 1; }
      .person .p-name { display: block; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .person .p-handle { display: block; font-size: 13px; color: var(--muted); }
      .person .p-bio { display: block; font-size: 12.5px; color: var(--muted); margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .person .p-nums { flex: none; text-align: right; font-size: 12.5px; color: var(--muted); line-height: 1.5; }
      .person .p-nums b { color: var(--ink); font-size: 14px; }
      /* 通知 */
      .notices { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
      .notice { display: flex; gap: 12px; align-items: flex-start; padding: 13px 15px; border-radius: 14px; border: 1px solid var(--card-border); background: var(--card); text-decoration: none; color: inherit; transition: border-color .18s ease; }
      .notice:hover { border-color: color-mix(in srgb, var(--accent-2) 50%, var(--card-border)); }
      .notice .n-icon { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--accent-2) 16%, transparent); font-size: 16px; }
      .notice .n-body { flex: 1; min-width: 0; font-size: 14px; line-height: 1.6; }
      .notice .n-body strong { font-weight: 700; }
      .notice .n-quote { display: block; margin-top: 4px; padding: 7px 10px; border-left: 2px solid color-mix(in srgb, var(--accent) 55%, transparent); color: var(--muted); font-size: 13px; white-space: pre-wrap; word-break: break-word; }
      .notice .n-time { flex: none; font-size: 12px; color: var(--muted); }
      nav .item.notify { position: relative; }
      nav .item.notify .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); margin-left: 4px; vertical-align: middle; box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
      .sec-head { margin-bottom: 4px; }
      .sec-head h2 { margin-bottom: 4px; }
      @media (max-width: 640px) {
        nav .wrap { flex-wrap: wrap; height: auto; row-gap: 2px; padding: 10px 16px 8px; }
        nav .logo { width: 100%; font-size: 17px; }
        nav .item { flex: 1 1 auto; text-align: center; font-size: 13px; padding: 7px 6px; }
        .profile-card { flex-direction: column; align-items: flex-start; }
        .app { padding: 24px 16px 70px; }
        .tabs3 { gap: 4px; }
        .tabs3 button { padding: 9px 12px; font-size: 13px; flex: 1; }
        .grid { grid-template-columns: 1fr; gap: 14px; }
        .work-cover { height: 150px; }
        .card { padding: 14px; }
        #mini { bottom: 10px; width: calc(100vw - 20px); padding: 8px 10px; gap: 8px; }
        .mini-cover { width: 38px; height: 38px; }
        .mini-time { display: none; }
        .pf-actions { width: 100%; }
        .pf-actions .btn { flex: 1; }
        .cmt-form .btn { padding: 8px 12px; }
        h2 { font-size: 22px; }
      }
      @media (min-width: 641px) and (max-width: 900px) {
        .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .profile-card { max-width: 100%; }
      }
      /* 触屏没有 hover：播放遮罩常显一点点，避免看不出可点 */
      @media (hover: none) {
        .card:hover .work-cover::after { opacity: .55; }
      }
    </style>

    <script>
      const cfg = window.MELO_CONFIG || {};
      const banner = document.getElementById('setupBanner');
      if (!cfg.url || !cfg.anonKey) banner.hidden = false;
      const sb = (window.supabase && cfg.url) ? window.supabase.createClient(cfg.url, cfg.anonKey) : null;

      // ---------- 通用小工具 ----------
      const $ = id => document.getElementById(id);
      const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const msg = (el, text, kind) => { el.textContent = text; el.classList.toggle('err', kind === 'err'); el.classList.toggle('ok', kind === 'ok'); };
      // 轻量 toast：比 alert 打断更少，也比静默失败友好
      function toast(text, kind) {
        let box = document.getElementById('toastBox');
        if (!box) {
          box = document.createElement('div');
          box.id = 'toastBox';
          box.className = 'toast-box';
          box.setAttribute('role', 'status');
          box.setAttribute('aria-live', 'polite');
          document.body.appendChild(box);
        }
        const el = document.createElement('div');
        el.className = 'toast' + (kind === 'err' ? ' err' : '');
        el.textContent = text;
        box.appendChild(el);
        requestAnimationFrame(() => el.classList.add('in'));
        setTimeout(() => { el.classList.remove('in'); setTimeout(() => el.remove(), 320); }, 2600);
      }
      // ---------- 人机验证（hCaptcha，sitekey 见 config.js） ----------
      const CAPTCHA_KEY = (cfg.captcha && cfg.captchaSiteKey) ? cfg.captchaSiteKey : '';
      let captchaToken = '';
      let captchaWidget = null;
      let captchaLoading = false;
      function renderCaptcha() {
        if (!window.hcaptcha || captchaWidget !== null) return;
        const box = $('captchaBox');
        if (!box) return;
        box.hidden = false;
        try {
          captchaWidget = window.hcaptcha.render(box, {
            sitekey: CAPTCHA_KEY,
            theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark',
            callback: t => { captchaToken = t; },
            'expired-callback': () => { captchaToken = ''; },
            'error-callback': () => { captchaToken = ''; },
          });
        } catch (e) { /* 同一容器重复 render 会抛错，忽略即可 */ }
      }
      function loadCaptcha() {
        if (!CAPTCHA_KEY) return;
        if (window.hcaptcha) { renderCaptcha(); return; }
        if (captchaLoading) return;
        captchaLoading = true;
        const s = document.createElement('script');
        s.src = 'https://js.hcaptcha.com/1/api.js?render=explicit&hl=zh';
        s.async = true; s.defer = true;
        s.onload = () => { captchaLoading = false; renderCaptcha(); };
        s.onerror = () => {
          captchaLoading = false;
          const box = $('captchaBox');
          if (box) { box.hidden = false; box.innerHTML = '<p class="msg err">人机验证加载失败，检查网络后刷新页面重试</p>'; }
        };
        document.head.appendChild(s);
      }
      function resetCaptcha() {
        captchaToken = '';
        if (window.hcaptcha && captchaWidget !== null) { try { window.hcaptcha.reset(captchaWidget); } catch (e) {} }
      }
      const captchaOpts = () => (CAPTCHA_KEY ? { captchaToken } : {});

      const initials = name => (name && name.trim()) ? name.trim().slice(0, 1).toUpperCase() : '🎵';
      const encPath = p => String(p).split('/').map(encodeURIComponent).join('/');

      // ---------- 主题切换 ----------
      const themeBtn = $('themeBtn');
      const setTheme = t => {
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('mm-theme', t); } catch (e) {}
        themeBtn.textContent = t === 'dark' ? '🌙' : '☀️';
        themeBtn.setAttribute('aria-label', t === 'dark' ? '切换到浅色主题' : '切换到深色主题');
      };
      setTheme(document.documentElement.dataset.theme || 'dark');
      themeBtn.addEventListener('click', () => setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));

      let user = null;
      let myProfile = null;
      let viewingUsername = '';
      const followingSet = new Set();
      const countedPlays = new Set();

      // ---------- 头像通用显示 ----------
      function setAvatar(el, url, name) {
        if (url) {
          // 用 CSS.escape 之外的方式防注入：只接受 http(s) 或站内相对地址
          const safe = /^https?:\/\//i.test(url) || url.startsWith('/') ? url : '';
          el.style.backgroundImage = safe ? `url("${safe.replace(/["\\]/g, '')}")` : '';
          el.style.backgroundSize = 'cover';
          el.style.backgroundPosition = 'center';
          el.textContent = safe ? '' : initials(name);
        } else { el.style.backgroundImage = ''; el.textContent = initials(name); }
      }

      // ---------- 关注名单展示 ----------
      async function renderFollowRows(followingIds, fanIds) {
        const rows = $('pfFollowRows'); if (!rows) return;
        const fetchNames = async ids => {
          if (!ids || !ids.length) return [];
          const { data } = await sb.from('profiles').select('username, display_name, bio').in('id', ids);
          return data || [];
        };
        const [fg, fs] = await Promise.all([fetchNames(followingIds), fetchNames(fanIds)]);
        const chips = list => list.length
          ? list.map(p => `<a class="chip" href="#/u/${esc(p.username)}" title="${esc(p.bio || '')}">${esc(p.display_name || p.username)}</a>`).join('')
          : '<span class="muted">还没有</span>';
        rows.innerHTML = `
          <div class="frow"><span class="lab">关注中：</span>${chips(fg)}</div>
          <div class="frow"><span class="lab">粉丝：</span>${chips(fs)}</div>
        `;
      }

      // ---------- 迷你播放条 ----------
      const mini = $('mini'), miniTitle = $('miniTitle'), miniCover = $('miniCover'),
            miniAuthor = $('miniAuthor'), miniFill = $('miniFill'), miniToggle = $('miniToggle'), miniClose = $('miniClose'),
            miniTime = $('miniTime'), miniCoverLabel = $('miniCoverLabel');
      const fmtT = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
      let currentAudio = null;
      miniToggle.addEventListener('click', () => { if (currentAudio) currentAudio.paused ? currentAudio.play() : currentAudio.pause(); });
      miniClose.addEventListener('click', () => { if (currentAudio) currentAudio.pause(); mini.hidden = true; });
      // 播放条上的进度可以点、可以拖（做成拖拽滑块）
      const seekAt = e => {
        if (!currentAudio || !currentAudio.duration) return;
        const bar = miniFill.parentElement;
        const r = bar.getBoundingClientRect();
        const x = Math.min(Math.max(e.clientX - r.left, 0), r.width);
        currentAudio.currentTime = (x / r.width) * currentAudio.duration;
        miniFill.style.width = (x / r.width * 100) + '%';
      };
      miniFill.parentElement.addEventListener('click', seekAt);
      miniFill.parentElement.addEventListener('pointerdown', e => {
        seekAt(e);
        const move = ev => seekAt(ev);
        const up = () => { removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
        addEventListener('pointermove', move); addEventListener('pointerup', up);
      });

      function wirePlay(card, audio, title, coverUrl, author) {
        // 点封面 = 播放 / 暂停
        const cover = card.querySelector('.work-cover');
        if (cover) {
          cover.setAttribute('title', '点击播放或暂停');
          cover.addEventListener('click', () => { if (audio.paused) audio.play(); else audio.pause(); });
        }
        audio.addEventListener('play', () => {
          document.querySelectorAll('audio').forEach(a => { if (a !== audio) a.pause(); });
          currentAudio = audio;
          mini.hidden = false;
          miniTitle.textContent = title;
          miniAuthor.textContent = author ? '🎤 ' + author : '';
          miniTime.textContent = '0:00 / ' + fmtT(audio.duration);
          if (coverUrl) { miniCoverLabel.style.backgroundImage = `url("${String(coverUrl).replace(/["\\]/g, '')}")`; miniCoverLabel.textContent = ''; }
          else { miniCoverLabel.style.backgroundImage = ''; miniCoverLabel.textContent = '🎤'; }
          miniCover.classList.add('spin');
          miniToggle.textContent = '⏸';
          card.classList.add('playing');
          // 播放量：每个作品每次进页面只计一次，避免刷新刷量
          const wid = audio.dataset.workId;
          if (sb && wid && !countedPlays.has(wid)) { countedPlays.add(wid); sb.rpc('bump_plays', { w: wid }).then(() => {}, () => {}); }
        });
        audio.addEventListener('playing', () => { miniToggle.textContent = '⏸'; });
        ['pause', 'ended'].forEach(ev => audio.addEventListener(ev, () => {
          miniToggle.textContent = '▶';
          miniCover.classList.remove('spin');
          card.classList.remove('playing');
        }));
        audio.addEventListener('timeupdate', () => {
          if (currentAudio !== audio) return;
          miniFill.style.width = (audio.currentTime / (audio.duration || 1) * 100) + '%';
          miniTime.textContent = fmtT(audio.currentTime) + ' / ' + fmtT(audio.duration);
        });
        // 空格键暂停 / 继续（不在输入框里时）
        audio.dataset.wired = '1';
      }

      // 全局空格键控制当前播放
      addEventListener('keydown', e => {
        if (e.code !== 'Space' || !currentAudio) return;
        const t = e.target;
        if (t && (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable)) return;
        e.preventDefault();
        currentAudio.paused ? currentAudio.play() : currentAudio.pause();
      });

      // ---------- 收藏（喜欢）状态 ----------
      const lovedSet = new Set();

      // ---------- 作品卡片模板 ----------
      // 评论面板：懒加载，只有点开才请求
      async function loadComments(workId, box, btn) {
        if (!sb) { box.innerHTML = '<p class="note">评论功能暂时不可用。</p>'; return; }
        box.innerHTML = '<p class="note">加载评论…</p>';
        const { data, error } = await sb.from('comments')
          .select('id, body, created_at, user_id, profiles!comments_user_id_fkey(username, display_name)')
          .eq('work_id', workId).order('created_at', { ascending: true }).limit(200);
        if (error) { box.innerHTML = `<p class="note">评论加载失败：${esc(error.message)}</p>`; return; }
        const rows = (data || []).map(c => {
          const who = c.profiles || {};
          const mine = user && c.user_id === user.id;
          const t = new Date(c.created_at);
          const when = `${t.getMonth() + 1}/${t.getDate()} ${String(t.getHours()).padStart(2, '0')}:${String(t.getMinutes()).padStart(2, '0')}`;
          return `<li class="cmt-item">
            <a class="cmt-who" href="#/u/${esc(who.username || '')}">${esc(who.display_name || who.username || '音乐人')}</a>
            <span class="cmt-time">${when}</span>
            ${mine ? `<button class="cmt-del" type="button" data-del="${esc(c.id)}" aria-label="删除这条评论">×</button>` : ''}
            <p class="cmt-body">${esc(c.body)}</p>
          </li>`;
        }).join('');
        box.innerHTML = `
          <ul class="cmt-list">${rows || '<li class="note">还没有人评论，来做第一个。</li>'}</ul>
          <div class="cmt-form">
            <input class="cmt-input" maxlength="300" placeholder="${user ? '说点什么…（最多 300 字）' : '登录后可以评论'}" ${user ? '' : 'disabled'} />
            <button class="btn primary cmt-send" type="button" ${user ? '' : 'disabled'}>发送</button>
          </div>`;
        const b = btn.querySelector('b');
        if (b) b.textContent = String((data || []).length);
        else if ((data || []).length) btn.insertAdjacentHTML('beforeend', ` <b>${data.length}</b>`);
        box.querySelectorAll('.cmt-del').forEach(el => el.addEventListener('click', async () => {
          el.disabled = true;
          const { error: de } = await sb.from('comments').delete().eq('id', el.dataset.del);
          if (de) { el.disabled = false; toast('删除失败：' + de.message, 'err'); return; }
          await loadComments(workId, box, btn);
        }));
        const input = box.querySelector('.cmt-input'), send = box.querySelector('.cmt-send');
        if (!input || !user) return;
        const submit = async () => {
          const body = input.value.trim();
          if (!body) return;
          send.disabled = true; input.disabled = true;
          const { error: ie } = await sb.from('comments').insert({ work_id: workId, user_id: user.id, body });
          send.disabled = false; input.disabled = false;
          if (ie) { toast('评论失败：' + ie.message, 'err'); return; }
          input.value = '';
          await loadComments(workId, box, btn);
        };
        send.addEventListener('click', submit);
        input.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); submit(); } });
      }

      function workCard(w, opts = {}) {
        const audioUrl = sb.storage.from('songs').getPublicUrl(w.storage_path).data.publicUrl;
        const who = w.profiles || {};
        // 每首作品一个稳定的色相，让封面不再千篇一律
        let hue = 0;
        for (const ch of String(w.id || w.title || '')) hue = (hue * 31 + ch.charCodeAt(0)) % 360;
        const div = document.createElement('div');
        const lc = Number((w.loves && w.loves[0] && w.loves[0].count) || 0);
        const cc = Number((w.comments && w.comments[0] && w.comments[0].count) || 0);
        div.className = 'card';
        div.innerHTML = `
          <div class="work-cover" aria-hidden="true" style="background:linear-gradient(135deg,hsl(${hue} 62% 32%),hsl(${(hue + 48) % 360} 74% 52%),hsl(${(hue + 110) % 360} 78% 62%))">🎤</div>
          <div class="row">
            <h3 style="margin:0;font-size:16.5px;">${esc(w.title)}</h3>
            ${opts.ownerView ? `<button class="del" data-id="${esc(w.id)}" title="删除作品" aria-label="删除作品《${esc(w.title)}》" type="button">🗑</button>` : ''}
          </div>
          ${w.note ? `<span class="note">${esc(w.note)}</span>` : ''}
          ${!opts.ownerView ? `<div class="byline">由 <a href="#/u/${esc(who.username || '')}">${esc(who.display_name || who.username || '神秘音乐人')}</a>${opts.mutual ? '<span class="mutual">互相关注</span>' : ''}</div>` : ''}
          <div class="card-foot">
            ${w.genre ? `<span class="work-genre">${esc(w.genre)}</span>` : ''}
            ${Number(w.duration) > 0 ? `<span class="dur">${fmtT(w.duration)}</span>` : ''}
            <span class="note" style="margin:0;">▶ ${Number(w.plays || 0)} 次播放</span>
            <button class="love${lovedSet.has(w.id) ? ' on' : ''}" type="button" data-love="${esc(w.id)}" aria-pressed="${lovedSet.has(w.id)}" aria-label="喜欢《${esc(w.title)}》">♥ <span>${lovedSet.has(w.id) ? '已喜欢' : '喜欢'}</span>${lc ? ` <b>${lc}</b>` : ''}</button>
            <button class="cmt-btn" type="button" data-cmt="${esc(w.id)}" aria-expanded="false">💬 评论${cc ? ` <b>${cc}</b>` : ''}</button>
            <button class="cmt-btn share" type="button" data-share="${esc(who.username || '')}" aria-label="复制《${esc(w.title)}》的链接">🔗</button>
          </div>
          <div class="cmt" data-cmt-box="${esc(w.id)}" hidden></div>
          <audio controls preload="none" src="${esc(audioUrl)}" data-work-id="${esc(w.id)}"></audio>
        `;
        wirePlay(div, div.querySelector('audio'), w.title, null,
          (w.profiles && (w.profiles.display_name || w.profiles.username)) || '');
        div.querySelector('.love').addEventListener('click', async () => {
          if (!sb) return;
          if (!user) { location.hash = '#/login'; return; }
          const btn = div.querySelector('.love'), wid = w.id, on = lovedSet.has(wid);
          btn.disabled = true;
          const res = on
            ? await sb.from('loves').delete().eq('user_id', user.id).eq('work_id', wid)
            : await sb.from('loves').insert({ user_id: user.id, work_id: wid });
          btn.disabled = false;
          if (res.error) { toast('操作失败：' + res.error.message, 'err'); return; }
          if (on) lovedSet.delete(wid); else lovedSet.add(wid);
          const now = lovedSet.has(wid);
          btn.classList.toggle('on', now);
          btn.setAttribute('aria-pressed', String(now));
          btn.querySelector('span').textContent = now ? '已喜欢' : '喜欢';
          const b = btn.querySelector('b');
          if (b) b.textContent = String(Math.max(0, Number(b.textContent || 0) + (now ? 1 : -1)));
          else if (now) btn.insertAdjacentHTML('beforeend', ' <b>1</b>');
        });
        // ---------- 分享：复制作者主页链接 ----------
        div.querySelector('.share').addEventListener('click', async e => {
          e.stopPropagation();
          const uname = who.username;
          const link = uname ? `${location.origin}/app/#/u/${uname}` : location.href;
          try {
            if (navigator.share) { await navigator.share({ title: w.title, text: `来听《${w.title}》`, url: link }); return; }
            await navigator.clipboard.writeText(link);
            toast('链接已复制，去分享给朋友吧 🔗', 'ok');
          } catch (err) {
            const ta = document.createElement('textarea');
            ta.value = link; document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); toast('链接已复制 🔗', 'ok'); }
            catch (e2) { toast('复制失败，手动复制：' + link, 'err'); }
            ta.remove();
          }
        });

        // ---------- 站内评论 ----------
        const cmtBtn = div.querySelector('.cmt-btn'), cmtBox = div.querySelector('.cmt');
        cmtBtn.addEventListener('click', async () => {
          const open = cmtBox.hidden === false;
          if (open) { cmtBox.hidden = true; cmtBtn.setAttribute('aria-expanded', 'false'); return; }
          cmtBox.hidden = false; cmtBtn.setAttribute('aria-expanded', 'true');
          await loadComments(w.id, cmtBox, cmtBtn);
        });

        const del = div.querySelector('.del');
        if (del) del.addEventListener('click', async () => {
          if (!sb || !confirm(`确定删除《${w.title}》吗？删除后不可恢复。`)) return;
          del.disabled = true;
          const { error } = await sb.from('works').delete().eq('id', w.id);
          if (error) { del.disabled = false; toast('删除失败：' + error.message, 'err'); return; }
          const rm = await sb.storage.from('songs').remove([w.storage_path]);
          if (rm.error) console.warn('音频文件删除失败：', rm.error.message);
          div.remove();
          msg($('profileMsg') || $('publishMsg'), '已删除', 'ok');
        });
        return div;
      }

      function renderWorkList(container, works, opts) {
        container.innerHTML = '';
        (works || []).forEach(w => container.appendChild(workCard(w, opts)));
      }

      // ---------- 视图路由： #/feed · #/publish · #/me · #/u/用户名 · #/login ----------
      const authView = $('authView'), resetView = $('resetView'), shell = $('shell'),
            feedView = $('feedView'), publishView = $('publishView'), meView = $('meView'),
            profileView = $('profileView'), discoverView = $('discoverView'), noticesView = $('noticesView');

      function showViews(v) {
        authView.hidden = !v.auth;
        if (v.auth) loadCaptcha();
        resetView.hidden = !v.reset;
        shell.hidden = !v.shell;
        // shell 隐藏时（如登录 / 找回密码界面）连带收掉所有子视图，避免留下残影
        const inShell = !!v.shell;
        profileView.hidden = !inShell || !v.profile;
        discoverView.hidden = !inShell || !v.discover;
        noticesView.hidden = !inShell || !v.notices;
        feedView.hidden = !inShell;
        publishView.hidden = !inShell;
        meView.hidden = !inShell;
        document.querySelectorAll('.tabs3 button').forEach(b => b.classList.remove('on'));
      }
      const tabStyle = name => {
        const b = document.querySelector(`.tabs3 button[data-view="${name}"]`);
        if (b) b.classList.add('on');
      };
      function syncAuthNav() {
        const btn = $('authNavBtn');
        if (user) { btn.textContent = '👤 ' + (myProfile?.display_name || myProfile?.username || '我'); btn.href = '#/me'; }
        else { btn.textContent = '登录 / 注册'; btn.href = '#/login'; }
        const nb = $('noticesNavBtn');
        if (nb) nb.hidden = !user;
      }

      async function route() {
        const raw = location.hash || '#/feed';
        // 找回密码邮件里带着 access_token / type=recovery，交给 supabase 自己解析
        if (/access_token=|type=recovery/.test(raw)) return;
        const hash = raw.split('?')[0];

        const m = hash.match(/^#\/u\/([a-zA-Z0-9_]+)$/);
        if (m) {
          const ok = await loadProfile(m[1]);
          if (ok) return;
          showViews({ shell: true, profile: false });
          location.hash = '#/feed';
          return;
        }

        const view = (hash.replace(/^#\//, '').split('/')[0] || 'feed');

        if (view === 'login') { if (user) { location.hash = '#/me'; return; } showViews({ auth: true }); return; }
        if (view === 'reset') { showViews({ reset: true }); return; }
        if (view === 'discover') {
          showViews({ shell: true, discover: true });
          $('guestBar').hidden = true;
          document.querySelector('.whoami').hidden = !user;
          await loadPeople(true);
          return;
        }
        if (view === 'notices') {
          if (!user) { showViews({ auth: true }); return; }
          showViews({ shell: true, notices: true });
          $('guestBar').hidden = true;
          document.querySelector('.whoami').hidden = false;
          await loadNotices();
          return;
        }
        if (view === 'feed' || view === '') {
          showViews({ shell: true });
          tabStyle('feed');
          feedView.hidden = false;
          $('guestBar').hidden = !!user;
          document.querySelector('.whoami').hidden = !user;
          await loadFeed(true);
          return;
        }
        if (!user) { showViews({ auth: true }); return; }
        showViews({ shell: true });
        if (view === 'publish') { tabStyle('publish'); publishView.hidden = false; await loadMine(); }
        else if (view === 'me') { tabStyle('me'); meView.hidden = false; await loadLoves(); }
        else { tabStyle('feed'); feedView.hidden = false; await loadFeed(true); }
      }
      addEventListener('hashchange', route);

      // ---------- 顶部三个 tab 可点（此前只有样式，没有点击） ----------
      document.querySelectorAll('.tabs3 button').forEach(btn => {
        btn.addEventListener('click', () => {
          const v = btn.dataset.view;
          if (v === 'feed') {
            // 已经在动态页时点一次也强制回顶刷新，避免 hash 不变导致无反应
            if (location.hash === '#/feed' || location.hash === '' ) { route(); }
            else location.hash = '#/feed';
          } else {
            location.hash = '#/' + v;
          }
        });
      });

      // ---------- 登录 / 注册 / 找回密码 ----------
      let signupMode = false;
      document.querySelectorAll('.seg').forEach(btn => btn.addEventListener('click', () => {
        document.querySelectorAll('.seg').forEach(b => { b.classList.remove('on'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('on'); btn.setAttribute('aria-selected', 'true');
        signupMode = btn.dataset.mode === 'signup';
        $('authBtn').textContent = signupMode ? '注册' : '登录';
        $('password').setAttribute('autocomplete', signupMode ? 'new-password' : 'current-password');
        msg($('authMsg'), '');
      }));

      $('authBtn').addEventListener('click', async () => {
        if (!sb) { msg($('authMsg'), '社区服务未配置', 'err'); return; }
        const email = $('email').value.trim(), password = $('password').value;
        if (!email || !password) { msg($('authMsg'), '邮箱和密码都要填哦', 'err'); return; }
        if (CAPTCHA_KEY && !captchaToken) { msg($('authMsg'), '先完成下面的人机验证', 'err'); return; }
        $('authBtn').disabled = true;
        msg($('authMsg'), signupMode ? '注册中…' : '登录中…');
        try {
          if (signupMode) {
            const { data, error } = await sb.auth.signUp({ email, password }, captchaOpts());
            if (error) throw error;
            if (data && data.session) { location.hash = '#/feed'; location.reload(); }
            else msg($('authMsg'), '注册成功！请先去邮箱点确认链接，再回来登录。', 'ok');
          } else {
            const { error } = await sb.auth.signInWithPassword({ email, password }, captchaOpts());
            if (error) throw error;
            location.hash = '#/feed';
            location.reload();
          }
        } catch (e) {
          const map = {
            'Invalid login credentials': '邮箱或密码不对，再检查一下',
            'Email not confirmed': '邮箱还没确认，先去收件箱点确认链接',
            'User already registered': '这个邮箱已经注册过了，直接登录吧',
            'Email rate limit exceeded': '邮件发太勤了，等几分钟再试',
            'Password should be at least 8 characters': '密码至少 8 位',
            'Signups not allowed for this instance': '暂时关闭了注册',
          };
          const raw = (e && e.message) || '';
          const friendly = /captcha/i.test(raw)
            ? '人机验证没通过或已过期，重新验证一次再提交'
            : (map[raw] || raw || '出错了，稍后再试');
          msg($('authMsg'), friendly, 'err');
          resetCaptcha();
        } finally { $('authBtn').disabled = false; }
      });

      $('forgotBtn').addEventListener('click', async () => {
        const email = $('email').value.trim();
        if (!email) { msg($('authMsg'), '先填上你的注册邮箱，再点「忘记密码」', 'err'); return; }
        if (!sb) return;
        if (CAPTCHA_KEY && !captchaToken) { msg($('authMsg'), '先完成下面的人机验证', 'err'); return; }
        const { error } = await sb.auth.resetPasswordForEmail(email, { redirectTo: location.origin + '/app/', ...captchaOpts() });
        resetCaptcha();
        const eraw = error ? (error.message || '') : '';
        const etext = /captcha/i.test(eraw)
          ? '人机验证没通过或已过期，重新验证一次再提交'
          : ('发送失败：' + eraw);
        msg($('authMsg'), error ? etext : '找回邮件已发出，请去邮箱点链接设置新密码。', error ? 'err' : 'ok');
      });

      $('resetBtn').addEventListener('click', async () => {
        const pwd = $('newPassword').value;
        if (pwd.length < 8) { msg($('resetMsg'), '密码至少 8 位', 'err'); return; }
        if (!sb) return;
        const { error } = await sb.auth.updateUser({ password: pwd });
        if (error) { msg($('resetMsg'), '设置失败：' + error.message, 'err'); return; }
        msg($('resetMsg'), '✅ 新密码已生效，正在进入社区…', 'ok');
        setTimeout(() => { location.hash = '#/feed'; location.reload(); }, 900);
      });

      $('logoutBtn').addEventListener('click', async () => {
        if (!sb) return;
        await sb.auth.signOut();
        location.hash = '#/feed';
        location.reload();
      });

      // ---------- 分享主页 ----------
      $('shareBtn').addEventListener('click', async () => {
        if (!viewingUsername) return;
        const link = `${location.origin}/app/#/u/${viewingUsername}`;
        try { await navigator.clipboard.writeText(link); }
        catch (e) { prompt('复制这个链接发给朋友：', link); return; }
        const btn = $('shareBtn'); const old = btn.textContent;
        btn.textContent = '✅ 已复制';
        setTimeout(() => btn.textContent = old, 1600);
      });

      // ---------- 回车直接提交 ----------
      ['email', 'password'].forEach(id => $(id).addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); $('authBtn').click(); }
      }));
      $('newPassword').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); $('resetBtn').click(); }
      });

      // ---------- 登录状态 ----------
      function setShell(profile) {
        myProfile = profile;
        $('mineName').textContent = profile.display_name || profile.username;
        $('mineHandle').textContent = '@' + profile.username;
        setAvatar($('mineAvatar'), profile.avatar_url, profile.display_name || profile.username);
        setAvatar($('avatarBtn'), profile.avatar_url, profile.display_name || profile.username);
        $('pfName').value = profile.display_name || '';
        $('pfBio').value = profile.bio || '';
        $('pfUsername').value = profile.username || '';
        $('myUrl').textContent = `${location.origin}/app/#/u/${profile.username}`;
        syncAuthNav();
      }

      async function loadProfile(username) {
        const { data: pf, error } = await sb.from('profiles').select('*').eq('username', username).maybeSingle();
        if (!pf || error) {
          showViews({ shell: true, profile: true });
          $('pfNotFound').hidden = false;
          $('pfCard').hidden = true;
          $('pfWorksList').innerHTML = '';
          $('pfEmpty').hidden = true;
          return true;
        }
        $('pfNotFound').hidden = true;
        $('pfCard').hidden = false;
        const isSelf = user && pf.id === user.id;
        const [followers, followingN, worksN, followersList, followingList] = await Promise.all([
          sb.from('follows').select('*', { count: 'exact', head: true }).eq('following_id', pf.id),
          sb.from('follows').select('*', { count: 'exact', head: true }).eq('follower_id', pf.id),
          sb.from('works').select('*', { count: 'exact', head: true }).eq('user_id', pf.id),
          sb.from('follows').select('follower_id').eq('following_id', pf.id),
          sb.from('follows').select('following_id').eq('follower_id', pf.id),
        ]);
        let mutual = false, iFollow = false;
        if (user && !isSelf) {
          iFollow = (followersList.data || []).some(f => f.follower_id === user.id);
          const back = await sb.from('follows').select('follower_id').eq('following_id', user.id).eq('follower_id', pf.id).maybeSingle();
          mutual = iFollow && !!back.data;
        }
        // 每个主页一条专属渐变横幅，颜色由用户名决定
        const banner = $('pfBanner');
        if (banner) {
          let h = 0;
          for (const ch of String(pf.username || '')) h = (h * 31 + ch.charCodeAt(0)) % 360;
          banner.style.background = `linear-gradient(120deg,hsl(${h} 68% 34%),hsl(${(h + 52) % 360} 74% 52%) 55%,hsl(${(h + 118) % 360} 80% 62%))`;
        }
        $('pfDisplay').textContent = pf.display_name || pf.username;
        viewingUsername = pf.username;
        $('pfHandle').textContent = '@' + pf.username;
        $('pfBio').textContent = pf.bio || '这位音乐人还没写简介。';
        setAvatar($('pfAvatar'), pf.avatar_url, pf.display_name || pf.username);
        renderFollowRows((followingList.data || []).map(x => x.following_id), (followersList.data || []).map(x => x.follower_id));
        $('pfWorks').textContent = worksN.count ?? 0;
        $('pfFollowers').textContent = followers.count ?? 0;
        $('pfFollowing').textContent = followingN.count ?? 0;

        const fBtn = $('followBtn');
        fBtn.hidden = !!isSelf;
        fBtn.disabled = !user;
        fBtn.textContent = isSelf ? '这是你自己' : (!user ? '登录后可关注' : (iFollow ? '✓ 已关注' : '+ 关注'));
        fBtn.onclick = async () => {
          if (!user) { location.hash = '#/login'; return; }
          fBtn.disabled = true;
          const res = iFollow
            ? await sb.from('follows').delete().eq('follower_id', user.id).eq('following_id', pf.id)
            : await sb.from('follows').insert({ follower_id: user.id, following_id: pf.id });
          fBtn.disabled = false;
          if (res.error) { toast('操作失败：' + res.error.message, 'err'); return; }
          iFollow = !iFollow;
          fBtn.textContent = iFollow ? '✓ 已关注' : '+ 关注';
          const nf = await sb.from('follows').select('*', { count: 'exact', head: true }).eq('following_id', pf.id);
          $('pfFollowers').textContent = nf.count ?? 0;
        };

        const { data: works } = await sb.from('works').select('*, profiles!works_user_id_fkey(username, display_name), loves(count), comments(count)').eq('user_id', pf.id).order('created_at', { ascending: false });
        showViews({ shell: true, profile: true });
        document.querySelectorAll('.tabs3 button').forEach(b => b.classList.remove('on'));
        renderWorkList($('pfWorksList'), works, {});
        $('pfEmpty').hidden = !!(works && works.length);
        return true;
      }

      // ---------- 社区动态（搜索 + 流派 + 最新/最热 + 加载更多） ----------
      const PAGE = 12;
      const feedState = { q: '', sort: 'new', genre: '', page: 0, done: false };
      const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
      const safeQuery = q => q.replace(/[,()%\\"]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 40);

      $('feedSearch').addEventListener('input', debounce(() => {
        feedState.q = safeQuery($('feedSearch').value);
        feedState.page = 0; feedState.done = false;
        loadFeed(true);
      }, 280));
      document.querySelectorAll('.smini').forEach(b => b.addEventListener('click', () => {
        document.querySelectorAll('.smini').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
        feedState.sort = b.dataset.sort;
        feedState.page = 0; feedState.done = false;
        loadFeed(true);
      }));
      $('feedMore').addEventListener('click', () => { feedState.page += 1; loadFeed(false); });
      // 键盘党：按 / 直接跳到搜索框，Esc 清空
      document.addEventListener('keydown', e => {
        const tag = (e.target.tagName || '').toLowerCase();
        if (e.key === '/' && tag !== 'input' && tag !== 'textarea') {
          const s = $('feedSearch');
          const view = $('feedView');
          if (s && view && !view.hidden) { e.preventDefault(); s.focus(); s.select(); }
        }
        if (e.key === 'Escape' && document.activeElement === $('feedSearch')) { $('feedSearch').value = ''; feedState.q = ''; loadFeed(true); }
      });
      document.querySelectorAll('.gchip').forEach(b => b.addEventListener('click', () => {
        document.querySelectorAll('.gchip').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
        feedState.genre = b.dataset.genre || '';
        feedState.page = 0; feedState.done = false;
        loadFeed(true);
      }));

      let feedSeq = 0;
      async function loadFeed(reset) {
        if (!sb) return;
        const list = $('feedList');
        const seq = ++feedSeq;
        if (reset) {
          list.innerHTML = Array.from({ length: 4 }).map(() => `
            <div class="card skel" aria-hidden="true">
              <div class="sk-cover"></div>
              <div class="sk-line w60"></div>
              <div class="sk-line w40"></div>
              <div class="sk-line w80"></div>
            </div>`).join('');
          feedState.page = 0; feedState.done = false;
        }
        const from = feedState.page * PAGE, to = from + PAGE - 1;
        let q = sb.from('works').select('*, profiles!works_user_id_fkey(username, display_name), loves(count), comments(count)', { count: 'exact' });
        if (feedState.q) q = q.or(`title.ilike.%${feedState.q}%,note.ilike.%${feedState.q}%`);
        if (feedState.genre) q = q.eq('genre', feedState.genre);
        q = feedState.sort === 'hot'
          ? q.order('plays', { ascending: false }).order('created_at', { ascending: false }).range(from, to)
          : q.order('created_at', { ascending: false }).range(from, to);
        const { data: works, count, error } = await q;
        if (seq !== feedSeq) return;   // 这次请求已过期（切了视图或换了筛选），丢弃结果
        if (error) {
          list.innerHTML = '<div class="empty">加载失败，请刷新页面再试</div>';
          $('feedMoreWrap').hidden = true;
          return;
        }
        if (reset) list.innerHTML = '';
        const rows = works || [];
        rows.forEach(w => list.appendChild(workCard(w, {})));
        if (reset && rows.length === 0) {
          list.innerHTML = feedState.q
            ? '<div class="empty">没找到相关作品，换个关键词试试 🎶</div>'
            : (feedState.genre
              ? `<div class="empty">这个流派还没有作品，等第一个「${esc(feedState.genre)}」出现 🎤<br><a href="#/publish">去发布</a></div>`
              : '<div class="empty">还没有作品，等你来当第一个发布者 🎤<br><a href="#/publish">去发布</a></div>');
        }
        const shown = from + rows.length;
        feedState.done = shown >= (count ?? 0) || rows.length < PAGE;
        $('feedMoreWrap').hidden = feedState.done;
        const parts = [];
        if (feedState.q) parts.push(`关键词「${feedState.q}」`);
        if (feedState.genre) parts.push(`流派「${feedState.genre}」`);
        parts.push(`${count ?? rows.length} 首作品`);
        if (feedState.sort === 'hot') parts.unshift('🔥 按播放量');
        $('feedStats').textContent = '🎧 ' + parts.join(' · ');
      }

      // ---------- 发现音乐人 ----------
      const PPL = 12;
      const peopleState = { q: '', page: 0, done: false };
      async function loadPeople(reset) {
        if (!sb) return;
        const list = $('peopleList');
        if (reset) {
          peopleState.page = 0; peopleState.done = false;
          list.innerHTML = Array.from({ length: 4 }).map(() => '<div class="card skel" aria-hidden="true"><div class="sk-line w60"></div><div class="sk-line w40"></div><div class="sk-line w80"></div></div>').join('');
        }
        const { data, error } = await sb.rpc('discover_people', {
          p_q: peopleState.q, p_limit: PPL, p_offset: peopleState.page * PPL
        });
        if (error) { list.innerHTML = '<div class="empty">加载失败，请刷新再试</div>'; $('peopleMoreWrap').hidden = true; return; }
        if (reset) list.innerHTML = '';
        const rows = data || [];
        rows.forEach(p => {
          const a = document.createElement('a');
          a.className = 'person';
          a.href = '#/u/' + p.username;
          a.innerHTML = `<div class="mini-avatar">${esc((p.display_name || p.username || '?').slice(0, 1))}</div>
            <div class="p-info"><span class="p-name">${esc(p.display_name || p.username)}</span><span class="p-handle">@${esc(p.username)}</span>${p.bio ? `<span class="p-bio">${esc(p.bio)}</span>` : ''}</div>
            <div class="p-nums"><b>${p.works_count ?? 0}</b> 作品<br><b>${p.followers_count ?? 0}</b> 粉丝</div>`;
          setAvatar(a.querySelector('.mini-avatar'), p.avatar_url, p.display_name || p.username);
          list.appendChild(a);
        });
        if (reset && rows.length === 0) {
          list.innerHTML = peopleState.q
            ? `<div class="empty">没找到叫「${esc(peopleState.q)}」的音乐人 🎐</div>`
            : '<div class="empty">社区刚开张，还没有音乐人入驻 🎤<br><a href="#/publish">发一首歌当第一个</a></div>';
        }
        const total = rows.length ? Number(rows[0].total ?? 0) : 0;
        peopleState.done = rows.length < PPL || (peopleState.page + 1) * PPL >= total;
        $('peopleMoreWrap').hidden = peopleState.done;
        $('peopleStats').textContent = rows.length ? `🧭 共 ${total} 位音乐人` : '';
      }

      // ---------- 通知 ----------
      const seenKey = 'mm-notices-seen';
      const seenAt = () => { try { return localStorage.getItem(seenKey) || ''; } catch (e) { return ''; } };
      function noticeText(n) {
        const who = `<a href="#/u/${esc(n.actor_username)}">${esc(n.actor_name || n.actor_username)}</a>`;
        const work = n.work_title ? `<strong>《${esc(n.work_title)}》</strong>` : '';
        if (n.kind === 'follow') return `${who} 关注了你`;
        if (n.kind === 'love') return `${who} 喜欢了你的 ${work}`;
        return `${who} 评论了你的 ${work}${n.body ? `<span class="n-quote">${esc(n.body)}</span>` : ''}`;
      }
      const noticeIcon = k => k === 'follow' ? '👋' : (k === 'love' ? '♥' : '💬');
      async function loadNotices() {
        if (!sb || !user) return;
        const list = $('noticeList');
        list.innerHTML = '<div class="card skel" aria-hidden="true"><div class="sk-line w60"></div><div class="sk-line w80"></div></div>';
        const { data, error } = await sb.rpc('my_notices', { p_limit: 40 });
        if (error) { list.innerHTML = '<div class="empty">通知加载失败，请刷新再试</div>'; return; }
        const rows = data || [];
        list.innerHTML = '';
        rows.forEach(n => {
          const el = document.createElement('div');
          el.className = 'notice';
          const href = n.kind === 'follow' ? '#/u/' + n.actor_username : (n.work_id ? '#/feed' : '#/feed');
          el.innerHTML = `<span class="n-icon" aria-hidden="true">${noticeIcon(n.kind)}</span>
            <div class="n-body">${noticeText(n)}</div>
            <span class="n-time">${timeAgo(n.created_at)}</span>`;
          if (n.work_id) { el.style.cursor = 'pointer'; el.addEventListener('click', e => { if (e.target.closest('a')) return; location.hash = '#/feed'; }); }
          list.appendChild(el);
        });
        $('noticeEmpty').hidden = rows.length > 0;
        // 打开通知页即视为已读
        try { localStorage.setItem(seenKey, rows[0]?.created_at || new Date().toISOString()); } catch (e) {}
        $('noticeDot').hidden = true;
      }
      function timeAgo(iso) {
        const t = new Date(iso).getTime();
        if (!t) return '';
        const d = Math.floor((Date.now() - t) / 1000);
        if (d < 60) return '刚刚';
        if (d < 3600) return Math.floor(d / 60) + ' 分钟前';
        if (d < 86400) return Math.floor(d / 3600) + ' 小时前';
        if (d < 86400 * 30) return Math.floor(d / 86400) + ' 天前';
        return new Date(t).toLocaleDateString('zh-CN');
      }
      // 未读红点：只取最新一条，和本地记录的已读时间比
      async function refreshNoticeDot() {
        if (!sb || !user) return;
        const { data } = await sb.rpc('my_notices', { p_limit: 1 });
        const newest = data?.[0]?.created_at || '';
        $('noticeDot').hidden = !newest || newest <= seenAt();
      }

      // ---------- 我的作品 ----------
      async function loadMine() {
        if (!sb || !user) return;
        const { data: works, count } = await sb.from('works').select('*', { count: 'exact' }).eq('user_id', user.id).order('created_at', { ascending: false });
        $('myCount').textContent = `共 ${count ?? 0} 首`;
        renderWorkList($('mineList'), works, { ownerView: true });
      }

      // ---------- 我喜欢的 ----------
      async function loadLoves() {
        if (!sb || !user) return;
        const { data } = await sb.from('loves')
          .select('work_id, created_at, works(id, title, note, genre, plays, duration, storage_path, user_id, profiles!works_user_id_fkey(username, display_name), loves(count), comments(count))')
          .eq('user_id', user.id)
          .order('created_at', { ascending: false });
        const works = (data || []).map(x => x.works).filter(Boolean);
        $('loveCount').textContent = works.length ? `共 ${works.length} 首` : '';
        $('loveEmpty').hidden = works.length > 0;
        renderWorkList($('loveList'), works, {});
      }

      // ---------- 发布（真实进度直传：百分比 / 已传大小 / 速度 / 预计剩余） ----------
      const MAX_BYTES = 50 * 1024 * 1024;
      // 上传前先在本地读一下音频时长，存进 works.duration（读不出来就当 0，不影响发布）
      function probeDuration(file) {
        return new Promise(resolve => {
          const url = URL.createObjectURL(file);
          const a = new Audio();
          const done = v => { try { URL.revokeObjectURL(url); } catch (e) {} resolve(v); };
          const timer = setTimeout(() => done(0), 6000);
          a.preload = 'metadata';
          a.onloadedmetadata = () => { clearTimeout(timer); done(Number.isFinite(a.duration) ? Math.round(a.duration) : 0); };
          a.onerror = () => { clearTimeout(timer); done(0); };
          a.src = url;
        });
      }
      function uploadWithProgress(path, file, token, onTick) {
        const url = cfg.url + '/storage/v1/object/songs/' + encPath(path);
        return new Promise((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          xhr.open('POST', url);
          xhr.setRequestHeader('Authorization', 'Bearer ' + token);
          xhr.setRequestHeader('apikey', cfg.anonKey);
          xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');
          xhr.setRequestHeader('x-upsert', 'false');
          xhr.upload.onprogress = e => { if (e.lengthComputable) onTick(e.loaded, e.total); };
          xhr.onload = () => (xhr.status >= 200 && xhr.status < 300) ? resolve() : reject(new Error('HTTP ' + xhr.status + ' ' + (xhr.responseText || '').slice(0, 120)));
          xhr.onerror = () => reject(new Error('网络中断'));
          xhr.ontimeout = () => reject(new Error('上传超时'));
          xhr.timeout = 10 * 60 * 1000;
          xhr.send(file);
        });
      }
      $('publishBtn').addEventListener('click', async () => {
        if (!sb || !user) { location.hash = '#/login'; return; }
        const title = $('songTitle').value.trim();
        const note = $('songNote').value.trim();
        const genre = $('songGenre').value || '其他';
        const file = $('songFile').files[0];
        msg($('publishMsg'), '');
        if (!title || !file) { msg($('publishMsg'), '歌曲标题和音频文件都要有哦', 'err'); return; }
        if (!/^audio\//.test(file.type) && !/\.(mp3|m4a|wav|ogg|flac|aac|webm)$/i.test(file.name)) {
          msg($('publishMsg'), '请选择音频文件（MP3 / M4A / WAV / OGG）', 'err'); return;
        }
        if (file.size > MAX_BYTES) { msg($('publishMsg'), '文件请小于 50MB', 'err'); return; }
        const duration = await probeDuration(file);
        const safeName = file.name.replace(/[^\w.\-]/g, '_').slice(-60);
        const path = `${user.id}/${Date.now()}-${safeName}`;
        const fmtMB = x => (x / 1048576).toFixed(1);
        let t0 = performance.now(), lastLoaded = 0, lastT = 0, hinted = false;
        const tick = (loaded, total) => {
          const now = performance.now();
          const pct = Math.min(100, Math.round(loaded / total * 100));
          $('upFill').style.width = pct + '%';
          let line = `已上传 ${fmtMB(loaded)} / ${fmtMB(total)} MB（${pct}%）`;
          if (lastLoaded && now - lastT >= 300) {
            const speed = (loaded - lastLoaded) / ((now - lastT) / 1000);
            if (speed > 0) {
              const sp = speed < 1048576 ? Math.max(1, Math.round(speed / 1024)) + ' KB/s' : (speed / 1048576).toFixed(1) + ' MB/s';
              line += ` · ${sp} · 剩余约 ${Math.max(1, Math.round((total - loaded) / speed))} 秒`;
            }
            lastLoaded = loaded; lastT = now;
          } else if (!lastLoaded) { lastLoaded = loaded; lastT = now; }
          if (!hinted && now - t0 > 20000) { hinted = true; line += ' · 跨洋线路稍慢，别关页面'; }
          $('upText').textContent = line;
        };
        $('publishBtn').disabled = true;
        $('upWrap').classList.add('show');
        try {
          const { data: { session } } = await sb.auth.getSession();
          if (!session) throw new Error('登录状态过期，请刷新页面重新登录');
          let ok = false, lastErr = null;
          for (let i = 0; i < 2 && !ok; i++) {
            try { await uploadWithProgress(path, file, session.access_token, tick); ok = true; }
            catch (e) {
              if (i === 0) { $('upFill').style.width = '0%'; msg($('publishMsg'), '⇄ 上传中断，正在自动重试…'); t0 = performance.now(); lastLoaded = 0; lastT = 0; }
              else lastErr = e;
            }
          }
          if (!ok) throw (lastErr || new Error('上传失败'));
          const ins = await sb.from('works').insert({ user_id: user.id, title, note, storage_path: path, genre, duration });
          if (ins.error) {
            // 元数据写入失败：清掉刚上传的音频，避免留下孤儿文件
            try { await sb.storage.from('songs').remove([path]); } catch (e) {}
            throw ins.error;
          }
          $('upFill').style.width = '100%';
          $('upText').textContent = '✅ 上传完成，正在发布…';
          msg($('publishMsg'), '🎉 发布成功！正在跳转到社区动态', 'ok');
          $('songTitle').value = ''; $('songNote').value = ''; $('songFile').value = '';
          feedState.page = 0; feedState.done = false;
          location.hash = '#/feed';
        } catch (e) {
          msg($('publishMsg'), '发布失败：' + (e.message || '未知错误'), 'err');
        } finally {
          $('publishBtn').disabled = false;
          setTimeout(() => { $('upWrap').classList.remove('show'); $('upFill').style.width = '0%'; }, 1800);
        }
      });

      // ---------- 资料编辑 ----------
      $('saveProfileBtn').addEventListener('click', async () => {
        if (!sb || !user) return;
        const display_name = $('pfName').value.trim() || '音乐人';
        const bio = $('pfBio').value.trim();
        const username = $('pfUsername').value.trim();
        msg($('profileMsg'), '');
        if (!/^[a-zA-Z0-9_]{2,24}$/.test(username)) { msg($('profileMsg'), '主页地址只能是 2-24 位字母、数字、下划线', 'err'); return; }
        if (username !== myProfile.username) {
          const dupe = await sb.from('profiles').select('id').eq('username', username).neq('id', user.id).maybeSingle();
          if (dupe.data) { msg($('profileMsg'), '这个主页地址已被占用', 'err'); return; }
        }
        $('saveProfileBtn').disabled = true;
        const { error } = await sb.from('profiles').update({ username, display_name, bio }).eq('id', user.id);
        $('saveProfileBtn').disabled = false;
        if (error) {
          // 23505 = 唯一键冲突（并发抢注），重查一次即可给出准确提示
          msg($('profileMsg'), error.code === '23505' ? '这个主页地址刚被别人占用了，换一个吧' : '保存失败：' + error.message, 'err');
          return;
        }
        myProfile = { ...myProfile, username, display_name, bio };
        setShell(myProfile);
        msg($('profileMsg'), '✅ 已保存，你的新主页地址已生效', 'ok');
      });

      // ---------- 头像更换 ----------
      $('avatarBtn').addEventListener('click', () => $('avatarFile').click());
      $('avatarFile').addEventListener('change', async () => {
        if (!sb || !user) return;
        const file = $('avatarFile').files[0];
        $('avatarFile').value = '';
        if (!file) return;
        if (!/^image\//.test(file.type)) { msg($('profileMsg'), '请选择图片文件（PNG/JPG/WEBP）', 'err'); return; }
        if (file.size > 3 * 1024 * 1024) { msg($('profileMsg'), '头像图片请小于 3MB', 'err'); return; }
        const { data: { session } } = await sb.auth.getSession();
        if (!session) { msg($('profileMsg'), '登录状态过期，请刷新页面', 'err'); return; }
        const ext = (file.name.match(/\.(png|jpe?g|gif|webp)$/i) || [null, 'png'])[1].toLowerCase();
        const path = `avatars/${user.id}/${Date.now()}.${ext}`;
        msg($('profileMsg'), '头像上传中…');
        $('avatarBtn').disabled = true;
        try {
          await new Promise((res, rej) => {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', cfg.url + '/storage/v1/object/songs/' + encPath(path));
            xhr.setRequestHeader('Authorization', 'Bearer ' + session.access_token);
            xhr.setRequestHeader('apikey', cfg.anonKey);
            xhr.setRequestHeader('Content-Type', file.type || 'image/png');
            xhr.onload = () => (xhr.status >= 200 && xhr.status < 300) ? res() : rej(new Error('HTTP ' + xhr.status));
            xhr.onerror = () => rej(new Error('网络中断'));
            xhr.send(file);
          });
          const url = sb.storage.from('songs').getPublicUrl(path).data.publicUrl;
          const prev = myProfile && myProfile.avatar_url;
          const { error } = await sb.from('profiles').update({ avatar_url: url }).eq('id', user.id);
          if (error) throw error;
          if (prev && prev.includes('/object/public/songs/')) {
            const oldPath = decodeURIComponent(prev.split('/object/public/songs/')[1] || '');
            if (oldPath && oldPath !== path) { try { await sb.storage.from('songs').remove([oldPath]); } catch (e) {} }
          }
          myProfile = { ...myProfile, avatar_url: url };
          setAvatar($('mineAvatar'), url, myProfile.display_name || myProfile.username);
          setAvatar($('avatarBtn'), url, myProfile.display_name || myProfile.username);
          msg($('profileMsg'), '✅ 头像已更新', 'ok');
        } catch (e) {
          msg($('profileMsg'), '头像上传失败：' + (e.message || '未知错误'), 'err');
        } finally {
          $('avatarBtn').disabled = false;
        }
      });

      // ---------- 启动 ----------
      // 发现音乐人：搜索（防抖）+ 加载更多
      let peopleTimer = null;
      $('peopleSearch').addEventListener('input', e => {
        clearTimeout(peopleTimer);
        const v = e.target.value.trim();
        peopleTimer = setTimeout(() => {
          peopleState.q = v.replace(/[%_\\]/g, '').slice(0, 40);
          loadPeople(true);
        }, 280);
      });
      $('peopleMore').addEventListener('click', () => { peopleState.page++; loadPeople(false); });
      $('noticesNavBtn').addEventListener('click', () => { $('noticeDot').hidden = true; });

      (async function boot() {
        if (!sb) { showViews({ shell: true }); feedView.hidden = false; return; }
        const { data } = await sb.auth.getUser();
        user = data?.user ?? null;
        if (user) {
          const { data: pf } = await sb.from('profiles').select('*').eq('id', user.id).maybeSingle();
          if (pf) setShell(pf);
          const { data: f } = await sb.from('follows').select('following_id').eq('follower_id', user.id);
          (f || []).forEach(x => followingSet.add(x.following_id));
          const { data: lv } = await sb.from('loves').select('work_id').eq('user_id', user.id);
          (lv || []).forEach(x => lovedSet.add(x.work_id));
        }
        syncAuthNav();
        refreshNoticeDot();
        sb.auth.onAuthStateChange((event, session) => {
          // 只处理真正改变登录态的事件，令牌刷新不重载页面
          if (event === 'PASSWORD_RECOVERY') { showViews({ reset: true }); location.hash = '#/reset'; return; }
          const nowIn = !!session?.user;
          const changed = nowIn !== !!user || (nowIn && session.user.id !== user?.id);
          if (changed) { user = session?.user ?? null; location.reload(); }
        });
        await route();
      })();
    </script>
  </body>
</html>
