---
// MeloMemo · 社区应用页（注册/登录、发布作品、社区动态、个人主页）
// 全部交互在浏览器端完成，后端是 Supabase（见 supabase/schema.sql 与 public/config.js）
import Content from '../data/content.js';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MeloMemo 社区 · 唱给你听</title>
    <meta name="description" content="MeloMemo 音乐社区：上传你的翻唱与原创，关注喜欢的声音，交到同好朋友。" />
    <link rel="icon" type="image/svg+xml" href="../favicon.svg" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
    <script is:inline src="../config.js"></script>
    <script is:inline>
      try { var __t = localStorage.getItem('mm-theme'); if (__t) document.documentElement.dataset.theme = __t; } catch (e) {}
    </script>
  </head>
  <body>
    <nav>
      <div class="wrap">
        <a class="logo" href="../">🎶 MeloMemo</a>
        <a class="item" href="../#about">关于我</a>
        <a class="item" href="#/feed">社区动态</a>
        <a class="item" href="#/publish">发布作品</a>
        <button id="themeBtn" title="切换明暗主题">🌙</button>
      </div>
    </nav>

    <main class="wrap app">
      <!-- 未接入 Supabase 时的提示 -->
      <div id="setupBanner" class="setup" hidden>
        🛠 社区服务正在初始化——数据库接上后这里就是注册入口。
      </div>

      <!-- 登录 / 注册 -->
      <section id="authView">
        <h2>🎤 加入 <span class="hl">MeloMemo 社区</span></h2>
        <p class="lead">注册一个账号，上传你的翻唱和原创，去别人的主页听歌、点关注，陪着音乐交朋友。</p>
        <div class="card auth-card">
          <div class="tabs2">
            <button class="seg on" data-mode="login">登录</button>
            <button class="seg" data-mode="signup">注册</button>
          </div>
          <label>邮箱 <input id="email" type="email" placeholder="you@example.com" autocomplete="email" /></label>
          <label>密码 <input id="password" type="password" placeholder="至少 6 位" autocomplete="current-password" /></label>
          <button id="authBtn" class="btn primary">登录</button>
          <p id="authMsg" class="msg"></p>
        </div>
      </section>

      <!-- 登录后的社区 -->
      <section id="shell" hidden>
        <div class="whoami card">
          <div class="mini-avatar" id="mineAvatar">🎵</div>
          <div class="who">
            <strong id="mineName"></strong>
            <span id="mineHandle" class="muted"></span>
          </div>
          <button id="logoutBtn" class="btn ghost tiny">退出登录</button>
        </div>

        <div class="tabs3">
          <button data-view="feed" class="on">🔥 社区动态</button>
          <button data-view="publish">⬆️ 发布作品</button>
          <button data-view="me">🏠 我的主页</button>
        </div>

        <!-- 社区动态 -->
        <div id="feedView">
          <div class="feed-tools">
            <input id="feedSearch" type="text" placeholder="🔍 搜索歌名或说明…" />
            <div class="sortseg">
              <button class="smini on" data-sort="new">最新</button>
              <button class="smini" data-sort="hot">最热</button>
            </div>
          </div>
          <div class="grid" id="feedList"></div>
        </div>

        <!-- 发布作品 -->
        <div id="publishView" hidden>
          <div class="card form-card">
            <label>歌曲标题 <input id="songTitle" maxlength="100" placeholder="例如：《南山南》翻唱" /></label>
            <label>一句话说明（可选）<input id="songNote" maxlength="200" placeholder="翻唱 · 吉他自弹 · 2026" /></label>
            <label>音频文件 <input id="songFile" type="file" accept="audio/*" /></label>
            <button id="publishBtn" class="btn primary">🚀 发布</button>
            <div id="upWrap" class="upwrap">
              <div class="upbar"><i id="upFill"></i></div>
              <div id="upText" class="uptext"></div>
            </div>
            <p id="publishMsg" class="msg"></p>
          </div>
          <h3 class="sub">我发布过的 <span id="myCount" class="muted"></span></h3>
          <div class="grid" id="mineList"></div>
        </div>

        <!-- 我的主页（编辑资料） -->
        <div id="meView" hidden>
          <div class="card form-card">
            <div class="av-edit">
              <button id="avatarBtn" class="mini-avatar big" title="点击更换头像">🎵</button>
              <span class="muted">点头像换新图<br />PNG/JPG · ≤3MB · 方形最佳</span>
              <input id="avatarFile" type="file" accept="image/*" hidden />
            </div>
            <label>昵称 <input id="pfName" maxlength="24" /></label>
            <label>个人简介 <input id="pfBio" maxlength="80" placeholder="一句话介绍你的音乐" /></label>
            <label>主页地址（字母/数字/下划线）<input id="pfUsername" maxlength="24" /></label>
            <button id="saveProfileBtn" class="btn primary">保存</button>
            <p id="profileMsg" class="msg"></p>
          </div>
          <p class="muted center">你的公开主页是：<span id="myUrl" class="mono"></span></p>
        </div>
      </section>

      <!-- 他人主页 -->
      <section id="profileView" hidden>
        <div class="card profile-card">
          <div class="mini-avatar big" id="pfAvatar">🎵</div>
          <div class="pf-head">
            <h2 id="pfDisplay"></h2>
            <span class="muted" id="pfHandle"></span>
            <p class="muted" id="pfBio"></p>
            <div class="stats">
              <span><b id="pfWorks">0</b> 作品</span>
              <span><b id="pfFollowers">0</b> 粉丝</span>
              <span><b id="pfFollowing">0</b> 关注中</span>
            </div>
            <div class="frows" id="pfFollowRows"></div>
          </div>
          <div class="pf-actions">
            <button id="followBtn" class="btn primary">关注</button>
            <button id="shareBtn" class="btn ghost tiny">🔗 分享主页</button>
          </div>
        </div>
        <div class="grid" id="pfWorksList"></div>
      </section>
    </main>

    <footer class="site"><div class="wrap">© 2026 MeloMemo · 音乐是交朋友最快的路</div></footer>

    <div id="mini" hidden>
      <div class="mini-cover" id="miniCover"><i class="disc-label" id="miniCoverLabel">🎤</i></div>
      <div class="mini-info"><strong id="miniTitle"></strong><span id="miniAuthor" class="mini-author"></span><div class="mini-timerow"><div class="mini-bar"><i id="miniFill"></i></div><span id="miniTime" class="mini-time">0:00 / 0:00</span></div></div>
      <button id="miniToggle" title="播放/暂停">⏸</button>
      <button id="miniClose" title="关闭">✕</button>
    </div>

    <style>
      .app { padding: 40px 22px 80px; min-height: 70vh; }
      .lead { color: var(--muted); margin: -6px 0 18px; }
      .muted { color: var(--muted); }
      .center { text-align: center; }
      .mono { font-family: Consolas, monospace; font-size: 14px; }
      .sub { margin: 26px 0 14px; font-size: 18px; }
      .setup { background: var(--card); border: 1.5px dashed var(--card-border); padding: 22px; border-radius: 18px; margin: 18px 0 26px; text-align: center; color: var(--muted); }
      .msg { min-height: 1.4em; color: var(--muted); font-size: 14px; margin: 8px 0 0; }
      .msg.err { color: var(--accent); }
      .auth-card, .form-card { max-width: 460px; display: flex; flex-direction: column; gap: 14px; padding: 24px; margin: 0 auto; }
      .auth-card label, .form-card label { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: var(--muted); }
      input[type=email], input[type=password], input[type=text], .form-card input:not([type=file]) {
        background: color-mix(in srgb, var(--bg) 55%, transparent);
        border: 1px solid var(--card-border); border-radius: 12px;
        color: var(--ink); padding: 11px 14px; font-size: 15px; outline: none;
      }
      input:focus { border-color: var(--accent-2); }
      .form-card input[type=file] { color: var(--muted); font-size: 13px; }
      .tabs2 { display: flex; gap: 6px; }
      .seg { flex: 1; padding: 10px; border-radius: 12px; border: 1px solid var(--card-border); background: none; color: var(--muted); cursor: pointer; font-size: 15px; }
      .seg.on { background: var(--gradient); color: #fff; border-color: transparent; font-weight: 700; }
      .whoami { flex-direction: row; align-items: center; gap: 12px; padding: 14px 18px; margin-bottom: 18px; }
      .who { display: flex; flex-direction: column; flex: 1; min-width: 0; }
      .who strong { font-size: 16px; }
      .btn.tiny { padding: 7px 14px; font-size: 13px; }
      .tabs3 { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
      .tabs3 button {
        padding: 10px 20px; border-radius: 999px; cursor: pointer; font-size: 14.5px;
        border: 1px solid var(--card-border); background: var(--card); color: var(--muted);
      }
      .tabs3 button.on { background: var(--gradient); color: #fff; border-color: transparent; font-weight: 700; }
      .mini-avatar {
        width: 46px; height: 46px; border-radius: 50%; flex: none;
        display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fff;
        background: var(--gradient);
      }
      .mini-avatar.big { width: 74px; height: 74px; font-size: 34px; }
      .av-edit { display: flex; align-items: center; gap: 14px; }
      #avatarBtn { cursor: pointer; border: none; padding: 0; background-size: cover; background-position: center; }
      #avatarBtn:hover { filter: brightness(1.12); }
      .mini-author { font-size: 12.5px; color: var(--muted); }
      .mini-timerow { display: flex; align-items: center; gap: 8px; }
      .mini-timerow .mini-bar { flex: 1; }
      .mini-time { font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; flex-shrink: 0; }
      .profile-card { flex-direction: row; align-items: center; gap: 16px; max-width: 640px; margin: 0 auto 22px; flex-wrap: wrap; }
      .pf-head { flex: 1; min-width: 200px; }
      .pf-head h2 { margin: 0 0 2px; font-size: 22px; }
      .pf-head p { margin: 4px 0; font-size: 14px; }
      .stats { display: flex; gap: 16px; font-size: 13.5px; color: var(--muted); margin-top: 8px; }
      .stats b { color: var(--ink); font-size: 15px; }
      .work-cover { height: 120px; border-radius: 14px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 40px; color: #fff; background: linear-gradient(135deg, #2b3a67, #6c8cff 55%, #ff5e7a); }
      .work-cover img { width: 100%; height: 120px; object-fit: cover; display: block; }
      .playing .work-cover { animation: spin 3.2s linear infinite; }
      .byline { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
      .byline a { color: var(--accent-2); text-decoration: none; font-weight: 700; }
      .del { border: none; background: none; color: var(--muted); cursor: pointer; font-size: 14px; padding: 4px 8px; border-radius: 8px; }
      .del:hover { color: var(--accent); background: var(--card); }
      .mutual { font-size: 12px; background: var(--gradient); color: #fff; padding: 3px 10px; border-radius: 999px; }
      .pf-actions { display: flex; flex-direction: column; gap: 8px; align-items: stretch; }
      .feed-tools { display: flex; gap: 10px; margin-bottom: 18px; align-items: center; flex-wrap: wrap; }
      .feed-tools input {
        flex: 1; min-width: 200px;
        background: var(--card); border: 1px solid var(--card-border); border-radius: 999px;
        color: var(--ink); padding: 10px 16px; font-size: 14.5px; outline: none;
      }
      .feed-tools input:focus { border-color: var(--accent-2); }
      .sortseg { display: flex; gap: 4px; }
      .smini { padding: 9px 16px; border-radius: 999px; border: 1px solid var(--card-border); background: var(--card); color: var(--muted); cursor: pointer; font-size: 14px; }
      .smini.on { background: var(--gradient); color: #fff; border-color: transparent; font-weight: 700; }
      .upwrap { display: none; flex-direction: column; gap: 6px; }
      .upwrap.show { display: flex; }
      .upbar { height: 8px; border-radius: 999px; background: color-mix(in srgb, var(--card-border) 60%, transparent); overflow: hidden; }
      .upbar i { display: block; height: 100%; width: 0%; border-radius: inherit; background: var(--gradient); transition: width .25s ease; }
      .uptext { font-size: 13px; color: var(--muted); text-align: center; }
      .frows { width: 100%; font-size: 13.5px; }
      .frow { display: flex; gap: 8px; align-items: flex-start; margin-top: 6px; flex-wrap: wrap; }
      .frow .lab { color: var(--muted); flex: none; padding-top: 4px; }
      .chip { display: inline-block; padding: 3px 12px; border-radius: 999px; background: color-mix(in srgb, var(--accent-2) 14%, transparent); color: var(--accent-2); text-decoration: none; font-weight: 600; }
      #toTop { display: none; }
      @media (max-width: 640px) {
        nav .wrap { flex-wrap: wrap; height: auto; row-gap: 2px; padding: 10px 16px 8px; }
        nav .logo { width: 100%; font-size: 17px; }
        nav .item { flex: 1 1 auto; text-align: center; font-size: 13px; padding: 7px 6px; }
        .profile-card { flex-direction: column; align-items: flex-start; }
      }
    </style>

    <script>
      const cfg = window.MELO_CONFIG || {};
      const banner = document.getElementById('setupBanner');
      if (!cfg.url || !cfg.anonKey) banner.hidden = false;
      const sb = (window.supabase && cfg.url) ? window.supabase.createClient(cfg.url, cfg.anonKey) : null;

      // ---------- 通用小工具 ----------
      const $ = id => document.getElementById(id);
      const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      const msg = (el, text, err) => { el.textContent = text; el.classList.toggle('err', !!err); };
      const initials = name => (name && name.trim()) ? name.trim().slice(0, 1).toUpperCase() : '🎵';

      // ---------- 主题切换 ----------
      const themeBtn = $('themeBtn');
      const setTheme = t => {
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('mm-theme', t); } catch (e) {}
        themeBtn.textContent = t === 'dark' ? '🌙' : '☀️';
      };
      setTheme(document.documentElement.dataset.theme || 'dark');
      themeBtn.addEventListener('click', () => setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));

      let user = null;
      let myProfile = null;
      let viewingUsername = '';
      const followingSet = new Set();

      // ---------- 头像通用显示 ----------
      function setAvatar(el, url, name) {
        if (url) { el.style.backgroundImage = `url(${esc(url)})`; el.style.backgroundSize = 'cover'; el.style.backgroundPosition = 'center'; el.textContent = ''; }
        else { el.style.backgroundImage = ''; el.textContent = initials(name); }
      }

      // ---------- 关注名单展示（关注中 / 粉丝，点名字直达主页） ----------
      async function renderFollowRows(followingIds, fanIds) {
        const rows = $('pfFollowRows'); if (!rows) return;
        const fetchNames = async ids => {
          if (!ids.length) return [];
          const { data } = await sb.from('profiles').select('username, display_name, bio').in('id', ids);
          return data || [];
        };
        const [fg, fs] = await Promise.all([fetchNames(followingIds), fetchNames(fanIds)]);
        const chips = list => list.length
          ? list.map(p => `<a class="chip" href="#/u/${esc(p.username)}" title="${esc(p.bio || '')}">${esc(p.display_name || p.username)}</a>`).join('')
          : '<span class="muted">还没有</span>';
        rows.innerHTML = `
          <div class="frow"><span class="lab">关注中：</span>${chips(fg)}</div>
          <div class="frow"><span class="lab">粉丝：</span>${chips(fs)}</div>
        `;
      }

      // ---------- 迷你播放条（与首页同款） ----------
      const mini = $('mini'), miniTitle = $('miniTitle'), miniCover = $('miniCover'),
            miniAuthor = $('miniAuthor'), miniFill = $('miniFill'), miniToggle = $('miniToggle'), miniClose = $('miniClose'),
            miniTime = $('miniTime'), miniCoverLabel = $('miniCoverLabel');
      const fmtT = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
      let currentAudio = null;
      miniToggle.addEventListener('click', () => { if (currentAudio) currentAudio.paused ? currentAudio.play() : currentAudio.pause(); });
      miniClose.addEventListener('click', () => { if (currentAudio) currentAudio.pause(); mini.hidden = true; });

      function wirePlay(card, audio, title, coverUrl, author) {
        audio.addEventListener('play', () => {
          document.querySelectorAll('audio').forEach(a => { if (a !== audio) a.pause(); });
          currentAudio = audio;
          mini.hidden = false;
          miniTitle.textContent = title;
          miniAuthor.textContent = author ? '🎤 ' + author : '';
          miniTime.textContent = '0:00 / ' + fmtT(audio.duration);
          if (coverUrl) { miniCoverLabel.style.backgroundImage = `url(${coverUrl})`; miniCoverLabel.textContent = ''; }
          else { miniCoverLabel.style.backgroundImage = ''; miniCoverLabel.textContent = '🎤'; }
          miniCover.classList.add('spin');
          miniToggle.textContent = '⏸';
          card.classList.add('playing');
          if (sb && audio.dataset.workId) sb.rpc('bump_plays', { w: audio.dataset.workId });
        });
        audio.addEventListener('playing', () => { miniToggle.textContent = '⏸'; });
        ['pause', 'ended'].forEach(ev => audio.addEventListener(ev, () => {
          miniToggle.textContent = '▶';
          miniCover.classList.remove('spin');
          card.classList.remove('playing');
        }));
        audio.addEventListener('timeupdate', () => {
          if (currentAudio !== audio) return;
          miniFill.style.width = (audio.currentTime / (audio.duration || 1) * 100) + '%';
          miniTime.textContent = fmtT(audio.currentTime) + ' / ' + fmtT(audio.duration);
        });
      }

      // ---------- 作品卡片模板 ----------
      function workCard(w, opts = {}) {
        const audioUrl = sb.storage.from('songs').getPublicUrl(w.storage_path).data.publicUrl;
        const who = w.profiles || {};
        const isMine = user && w.user_id === user.id;
        const div = document.createElement('div');
        div.className = 'card';
        div.innerHTML = `
          <div class="work-cover">🎤</div>
          <div class="row">
            <h3 style="margin:0;font-size:16.5px;">${esc(w.title)}</h3>
            ${opts.ownerView ? `<button class="del" data-id="${w.id}" title="删除作品">🗑</button>` : ''}
          </div>
          ${w.note ? `<span class="note">${esc(w.note)}</span>` : ''}
          ${!opts.ownerView ? `<div class="byline">由 <a href="#/u/${esc(who.username || '')}">${esc(who.display_name || who.username || '神秘音乐人')}</a>${opts.mutual ? '<span class="mutual">互相关注</span>' : ''}</div>` : ''}
          <span class="note">▶ ${w.plays || 0} 次播放</span>
          <audio controls preload="none" src="${esc(audioUrl)}" data-work-id="${w.id}"></audio>
        `;
        wirePlay(div, div.querySelector('audio'), w.title, w.works_cover || null,
          (w.profiles && (w.profiles.display_name || w.profiles.username)) ||
          (user && w.user_id === user.id && myProfile ? (myProfile.display_name || myProfile.username) : ''));
        const del = div.querySelector('.del');
        if (del) del.addEventListener('click', async () => {
          if (!sb || !confirm(`确定删除《${w.title}》吗？`)) return;
          await sb.from('works').delete().eq('id', w.id);
          await sb.storage.from('songs').remove([w.storage_path]);
          div.remove();
        });
        return div;
      }

      function renderWorkList(container, works, opts) {
        container.innerHTML = '';
        works.forEach(w => container.appendChild(workCard(w, opts)));
      }

      // ---------- 视图路由： #/feed · #/publish · #/me · #/u/用户名 ----------
      const authView = $('authView'), shell = $('shell'),
            feedView = $('feedView'), publishView = $('publishView'), meView = $('meView'),
            profileView = $('profileView');

      function showViews(v) {
        authView.hidden = !v.auth;
        shell.hidden = !v.shell;
        profileView.hidden = !v.profile;
        feedView.hidden = true;
        publishView.hidden = true;
        meView.hidden = true;
        document.querySelectorAll('.tabs3 button').forEach(b => b.classList.remove('on'));
      }
      const tabStyle = name => {
        const b = document.querySelector(`.tabs3 button[data-view="${name}"]`);
        if (b) b.classList.add('on');
      };

      async function route() {
        const hash = location.hash || '#/feed';
        if (!sb || !user) { showViews({ auth: true }); return; }
        const m = hash.match(/^#\/u\/([a-zA-Z0-9_]+)$/);
        if (m) {
          const target = await loadProfile(m[1]);
          if (target) return; // loadProfile 已渲染
          location.hash = '#/feed';
        }
        showViews({ shell: true });
        const view = hash.replace('#/', '') || 'feed';
        if (view === 'publish') { tabStyle('publish'); publishView.hidden = false; await loadMine(); }
        else if (view === 'me') { tabStyle('me'); meView.hidden = false; }
        else { tabStyle('feed'); feedView.hidden = false; await loadFeed(); }
      }
      addEventListener('hashchange', route);

      // ---------- 登录 / 注册 ----------
      let signupMode = false;
      document.querySelectorAll('.seg').forEach(btn => btn.addEventListener('click', () => {
        document.querySelectorAll('.seg').forEach(b => b.classList.remove('on'));
        btn.classList.add('on');
        signupMode = btn.dataset.mode === 'signup';
        $('authBtn').textContent = signupMode ? '注册' : '登录';
        msg($('authMsg'), '');
      }));
      $('authBtn').addEventListener('click', async () => {
        if (!sb) return;
        const email = $('email').value.trim(), password = $('password').value;
        msg($('authMsg'), '处理中…');
        try {
          if (signupMode) {
            const { error } = await sb.auth.signUp({ email, password });
            if (error) throw error;
            msg($('authMsg'), '注册成功！如果平台开启了邮箱验证，请先去邮箱点确认邮件，再回来登录。');
          } else {
            const { error } = await sb.auth.signInWithPassword({ email, password });
            if (error) throw error;
          }
        } catch (e) {
          msg($('authMsg'), (e.message || '出错了，检查邮箱和密码是否正确') , true);
        }
      });
      $('logoutBtn').addEventListener('click', () => sb && sb.auth.signOut());

      // ---------- 一键分享当前主页 ----------
      $('shareBtn').addEventListener('click', async () => {
        if (!viewingUsername) return;
        const link = `${location.origin}/app#/u/${viewingUsername}`;
        try { await navigator.clipboard.writeText(link); }
        catch (e) { prompt('复制这个链接发给朋友：', link); return; }
        const btn = $('shareBtn'); btn.textContent = '✅ 已复制'; setTimeout(() => btn.textContent = '🔗 分享主页', 1600);
      });

      // ---------- 回车直接登录 / 注册 ----------
      ['email', 'password'].forEach(id => $(id).addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); $('authBtn').click(); }
      }));

      // ---------- 登录状态 ----------
      function setShell(profile) {
        myProfile = profile;
        $('mineName').textContent = profile.display_name || profile.username;
        $('mineHandle').textContent = '@' + profile.username;
        setAvatar($('mineAvatar'), profile.avatar_url, profile.display_name || profile.username);
        setAvatar($('avatarBtn'), profile.avatar_url, profile.display_name || profile.username);
        $('pfName').value = profile.display_name || '';
        $('pfBio').value = profile.bio || '';
        $('pfUsername').value = profile.username || '';
        $('myUrl').textContent = `${location.origin}/app#/u/${profile.username}`;
      }

      async function loadProfile(username) {
        const { data: pf, error } = await sb.from('profiles').select('*').eq('username', username).maybeSingle();
        if (!pf || error) return false;
        const isSelf = user && pf.id === user.id;
        const [{ count: followers }, { count: followingN }, { count: worksN }, followsData, followingData] = await Promise.all([
          sb.from('follows').select('*', { count: 'exact', head: true }).eq('following_id', pf.id),
          sb.from('follows').select('*', { count: 'exact', head: true }).eq('follower_id', pf.id),
          sb.from('works').select('*', { count: 'exact', head: true }).eq('user_id', pf.id),
          sb.from('follows').select('follower_id').eq('following_id', pf.id),
          sb.from('follows').select('following_id').eq('follower_id', pf.id),
        ]);
        let mutual = false, iFollow = false;
        if (user && !isSelf) {
          iFollow = followsData.data.some(f => f.follower_id === user.id);
          const theyFollowMe = await sb.from('follows').select('follower_id').eq('following_id', user.id).eq('follower_id', pf.id).maybeSingle();
          mutual = iFollow && !!theyFollowMe.data;
        }
        $('pfDisplay').textContent = pf.display_name || pf.username;
        viewingUsername = pf.username;
        $('pfHandle').textContent = '@' + pf.username;
        $('pfBio').textContent = pf.bio || '这位音乐人还没写简介。';
        setAvatar($('pfAvatar'), pf.avatar_url, pf.display_name || pf.username);
        renderFollowRows(followingData.data.map(x => x.following_id), followsData.data.map(x => x.follower_id));        $('pfWorks').textContent = worksN ?? 0;
        $('pfFollowers').textContent = followers ?? 0;
        $('pfFollowing').textContent = followingN ?? 0;
        const fBtn = $('followBtn');
        fBtn.hidden = isSelf;
        fBtn.disabled = !user;
        fBtn.textContent = isSelf ? '这是你自己' : (iFollow ? '✓ 已关注' : '+ 关注');
        fBtn.onclick = async () => {
          if (!user) { msg($('authMsg'), '先登录再关注哦'); return; }
          if (iFollow) { await sb.from('follows').delete().eq('follower_id', user.id).eq('following_id', pf.id); iFollow = false; }
          else { await sb.from('follows').insert({ follower_id: user.id, following_id: pf.id }); iFollow = true; }
          fBtn.textContent = iFollow ? '✓ 已关注' : '+ 关注';
          const nf = await sb.from('follows').select('*', { count: 'exact', head: true }).eq('following_id', pf.id);
          $('pfFollowers').textContent = nf.count ?? 0;
          route();
        };
        const { data: works } = await sb.from('works').select('*, profiles(username, display_name)').eq('user_id', pf.id).order('created_at', { ascending: false });
        showViews({ profile: true });
        renderWorkList($('pfWorksList'), works || {}, {});
        return true;
      }

      // ---------- 社区动态（搜索 + 最新/最热排序） ----------
      const feedState = { q: '', sort: 'new' };
      const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
      $('feedSearch').addEventListener('input', debounce(() => {
        feedState.q = $('feedSearch').value.trim();
        loadFeed();
      }, 280));
      document.querySelectorAll('.smini').forEach(b => b.addEventListener('click', () => {
        document.querySelectorAll('.smini').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
        feedState.sort = b.dataset.sort;
        loadFeed();
      }));
      async function loadFeed() {
        if (!sb) return;
        let q = sb.from('works').select('*, profiles(username, display_name)');
        if (feedState.q) q = q.or(`title.ilike.%${feedState.q}%,note.ilike.%${feedState.q}%`);
        q = feedState.sort === 'hot'
          ? q.order('plays', { ascending: false }).order('created_at', { ascending: false }).limit(40)
          : q.order('created_at', { ascending: false }).limit(40);
        const { data: works } = await q;
        const list = $('feedList');
        list.innerHTML = '';
        (works || []).forEach(w => list.appendChild(workCard(w, {})));
        if (!works || works.length === 0)
          list.innerHTML = feedState.q
            ? '<div class="empty">没找到相关作品，换个关键词试试 🎶</div>'
            : '<div class="empty">还没有作品，等你来当第一个发布者 🎤</div>';
      }

      // ---------- 我的作品 ----------
      async function loadMine() {
        if (!sb || !user) return;
        const { data: works, count } = await sb.from('works').select('*', { count: 'exact' }).eq('user_id', user.id).order('created_at', { ascending: false });
        $('myCount').textContent = `共 ${count ?? 0} 首`;
        renderWorkList($('mineList'), works || [], { ownerView: true });
      }

      // ---------- 发布（真实进度直传：百分比 / 已传大小 / 速度 / 预计剩余） ----------
      function uploadWithProgress(path, file, token, onTick) {
        const url = cfg.url + '/storage/v1/object/songs/' + path.split('/').map(encodeURIComponent).join('/');
        return new Promise((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          xhr.open('POST', url);
          xhr.setRequestHeader('Authorization', 'Bearer ' + token);
          xhr.setRequestHeader('apikey', cfg.anonKey);
          xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');
          xhr.upload.onprogress = e => { if (e.lengthComputable) onTick(e.loaded, e.total); };
          xhr.onload = () => (xhr.status >= 200 && xhr.status < 300) ? resolve() : reject(new Error('HTTP ' + xhr.status + ' ' + (xhr.responseText || '').slice(0, 120)));
          xhr.onerror = () => reject(new Error('网络中断'));
          xhr.ontimeout = () => reject(new Error('上传超时'));
          xhr.send(file);
        });
      }
      $('publishBtn').addEventListener('click', async () => {
        if (!sb || !user) return;
        const title = $('songTitle').value.trim();
        const note = $('songNote').value.trim();
        const file = $('songFile').files[0];
        msg($('publishMsg'), '');
        if (!title || !file) { msg($('publishMsg'), '歌曲标题和音频文件都要有哦', true); return; }
        if (file.size > 50 * 1024 * 1024) { msg($('publishMsg'), '文件请小于 50MB', true); return; }
        const path = `${user.id}/${Date.now()}-${file.name.replace(/[^\w.\-]/g, '_')}`;
        const fmtMB = x => (x / 1048576).toFixed(1);
        let t0 = performance.now(), lastLoaded = 0, lastT = 0, hinted = false;
        const tick = (loaded, total) => {
          const now = performance.now();
          const pct = Math.min(100, Math.round(loaded / total * 100));
          $('upFill').style.width = pct + '%';
          let line = `已上传 ${fmtMB(loaded)} / ${fmtMB(total)} MB（${pct}%）`;
          if (lastLoaded && now - lastT >= 300) {
            const speed = (loaded - lastLoaded) / ((now - lastT) / 1000);
            if (speed > 0) {
              const sp = speed < 1048576 ? Math.max(1, Math.round(speed / 1024)) + ' KB/s' : (speed / 1048576).toFixed(1) + ' MB/s';
              line += ` · ${sp} · 剩余约 ${Math.max(1, Math.round((total - loaded) / speed))} 秒`;
            }
            lastLoaded = loaded; lastT = now;
          } else if (!lastLoaded) { lastLoaded = loaded; lastT = now; }
          if (!hinted && now - t0 > 20000) { hinted = true; line += '<span style="opacity:.8"> · 线路跨洋稍慢，上传仍在稳定进行，别关页面</span>'; }
          $('upText').innerHTML = line;
        };
        $('publishBtn').disabled = true;
        $('upWrap').classList.add('show');
        try {
          const { data: { session } } = await sb.auth.getSession();
          if (!session) throw new Error('登录状态过期，请刷新页面重新登录');
          let ok = false, lastErr = null;
          for (let i = 0; i < 2 && !ok; i++) {
            try { await uploadWithProgress(path, file, session.access_token, tick); ok = true; }
            catch (e) {
              if (i === 0) { $('upFill').style.width = '0%'; msg($('publishMsg'), '⇄ 上传中断，正在自动重试…'); t0 = performance.now(); lastLoaded = 0; lastT = 0; }
              else lastErr = e;
            }
          }
          if (!ok) throw (lastErr || new Error('上传失败'));
          const ins = await sb.from('works').insert({ user_id: user.id, title, note, storage_path: path });
          if (ins.error) throw ins.error;
          $('upFill').style.width = '100%';
          $('upText').textContent = '✅ 上传完成，正在发布…';
          msg($('publishMsg'), '🎉 发布成功！已跳转到社区动态');
          $('songTitle').value = ''; $('songNote').value = ''; $('songFile').value = '';
          location.hash = '#/feed';
        } catch (e) {
          msg($('publishMsg'), '发布失败：' + (e.message || '未知错误'), true);
        } finally {
          $('publishBtn').disabled = false;
          setTimeout(() => { $('upWrap').classList.remove('show'); $('upFill').style.width = '0%'; }, 1800);
        }
      });

      // ---------- 资料编辑 ----------
      function fillProfileForm() { /* 已在 setShell 填好 */ }
      $('saveProfileBtn').addEventListener('click', async () => {
        if (!sb || !user) return;
        const display_name = $('pfName').value.trim() || '音乐人';
        const bio = $('pfBio').value.trim();
        const username = $('pfUsername').value.trim();
        msg($('profileMsg'), '');
        if (!/^[a-zA-Z0-9_]{2,24}$/.test(username)) { msg($('profileMsg'), '主页地址只能是 2-24 位字母、数字、下划线', true); return; }
        const dupe = await sb.from('profiles').select('id').eq('username', username).neq('id', user.id).maybeSingle();
        if (dupe.data) { msg($('profileMsg'), '这个主页地址已被占用', true); return; }
        const { error } = await sb.from('profiles').update({ username, display_name, bio }).eq('id', user.id);
        if (error) { msg($('profileMsg'), '保存失败：' + error.message, true); return; }
        myProfile = { ...myProfile, username, display_name, bio };
        setShell(myProfile);
        msg($('profileMsg'), '✅ 已保存，你的新主页地址已生效');
      });

      // ---------- 头像更换 ----------
      $('avatarBtn').addEventListener('click', () => $('avatarFile').click());
      $('avatarFile').addEventListener('change', async () => {
        if (!sb || !user) return;
        const file = $('avatarFile').files[0];
        $('avatarFile').value = '';
        if (!file) return;
        if (!/^image\//.test(file.type)) { msg($('profileMsg'), '请选择图片文件（PNG/JPG/WEBP）', true); return; }
        if (file.size > 3 * 1024 * 1024) { msg($('profileMsg'), '头像图片请小于 3MB', true); return; }
        const { data: { session } } = await sb.auth.getSession();
        if (!session) { msg($('profileMsg'), '登录状态过期，请刷新页面', true); return; }
        const ext = (file.name.match(/\.(png|jpe?g|gif|webp)$/i) || [null, 'png'])[1];
        const path = `avatars/${user.id}/${Date.now()}.${ext}`;
        msg($('profileMsg'), '头像上传中…');
        $('avatarBtn').disabled = true;
        try {
          await new Promise((res, rej) => {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', cfg.url + '/storage/v1/object/songs/' + path.split('/').map(encodeURIComponent).join('/'));
            xhr.setRequestHeader('Authorization', 'Bearer ' + session.access_token);
            xhr.setRequestHeader('apikey', cfg.anonKey);
            xhr.setRequestHeader('Content-Type', file.type || 'image/png');
            xhr.onload = () => (xhr.status >= 200 && xhr.status < 300) ? res() : rej(new Error('HTTP ' + xhr.status));
            xhr.onerror = () => rej(new Error('网络中断'));
            xhr.send(file);
          });
          const url = sb.storage.from('songs').getPublicUrl(path).data.publicUrl;
          const prev = myProfile && myProfile.avatar_url;
          if (prev && prev.includes('/object/public/songs/avatars/')) {
            const oldPath = decodeURIComponent(prev.split('/object/public/songs/')[1] || '');
            if (oldPath && oldPath !== path) { try { await sb.storage.from('songs').remove([oldPath]); } catch (e) {} }
          }
          const { error } = await sb.from('profiles').update({ avatar_url: url }).eq('id', user.id);
          if (error) throw error;
          myProfile = { ...myProfile, avatar_url: url };
          setAvatar($('mineAvatar'), url, myProfile.display_name || myProfile.username);
          setAvatar($('avatarBtn'), url, myProfile.display_name || myProfile.username);
          msg($('profileMsg'), '✅ 头像已更新');
        } catch (e) {
          msg($('profileMsg'), '头像上传失败：' + (e.message || '未知错误'), true);
        } finally {
          $('avatarBtn').disabled = false;
        }
      });

      // ---------- 启动 ----------
      (async function boot() {
        if (!sb) return;
        const { data } = await sb.auth.getUser();
        user = data?.user ?? null;
        if (user) {
          const { data: pf } = await sb.from('profiles').select('*').eq('id', user.id).maybeSingle();
          if (pf) setShell(pf);
          const { data: f } = await sb.from('follows').select('following_id').eq('follower_id', user.id);
          (f || []).forEach(x => followingSet.add(x.following_id));
        }
        sb.auth.onAuthStateChange((event, session) => {
          const nowIn = !!session?.user;
          if (nowIn !== !!user || (nowIn && session.user.id !== user?.id)) {
            user = session?.user ?? null;
            if (nowIn) location.reload();
            else location.reload();
          }
        });
        await route();
      })();
    </script>
  </body>
</html>
